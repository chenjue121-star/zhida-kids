<view class="home-page">
  <view wx:if="{{loading && !ready && !error}}" class="home-loading" aria-label="正在读取家庭与宝贝资料"><view class="skeleton-child"><view class="skeleton-face"></view><view class="skeleton-name"></view></view><view class="skeleton-stage"></view><view class="loading-copy">正在读取家庭与宝贝资料…</view></view>
  <view wx:if="{{error && !ready}}" class="home-error"><image src="/assets/family-house.png" mode="aspectFit" aria-hidden="true"/><view class="empty-title">{{accessRevoked ? '家庭访问已失效' : '暂时无法读取资料'}}</view><view class="empty-copy">{{accessRevoked ? '你已无法查看这个家庭，可选择其他家庭继续使用。' : '请检查网络后重试。'}}</view><button wx:if="{{accessRevoked}}" class="primary" bindtap="families">选择其他家庭</button><button wx:else class="primary" bindtap="retry" disabled="{{loading}}">重新连接</button></view>
  <block wx:if="{{ready}}">
    <view wx:if="{{child}}" class="current-child" bindtap="openChildSwitch" aria-role="button" aria-label="切换宝贝"><view class="child-initial">{{child.initial}}</view><view class="current-child-copy"><view class="current-child-name">{{childNickname || child.nickname}}</view><view class="current-child-age">{{childAge || age}}</view></view><view class="switch-command c-dropdown">切换宝贝</view></view>
    <view wx:else class="family-line"><view>{{family.name || '我的家庭'}}<text wx:if="{{role === 'viewer'}}" class="viewer-role">仅查看</text></view><view class="family-link" bindtap="familyDetail" aria-role="button">家庭与成员 ›</view></view>
    <view wx:if="{{!child}}" class="home-empty"><image src="/assets/family-house.png" mode="aspectFit" aria-hidden="true"/><view class="empty-title">{{role === 'viewer' ? '这个家庭还没有宝贝' : '还没有宝贝'}}</view><view class="empty-copy">{{role === 'viewer' ? '等待管理员添加宝贝后，就能在这里查看档案。' : '添加宝贝，就可以开始准备穿搭。'}}</view><button wx:if="{{writable}}" class="primary" bindtap="addChild">添加宝贝</button><view wx:else class="viewer-link" bindtap="familyDetail" aria-role="button">查看家庭与成员 ›</view></view>
    <block wx:else>
      <view class="day-tabs"><button class="{{mode === 'today' ? 'active' : ''}}" data-mode="today" bindtap="mode">今天<text wx:if="{{todayLabel}}"> · {{todayLabel}}</text></button><button class="{{mode === 'tomorrow' ? 'active' : ''}}" data-mode="tomorrow" bindtap="mode">明天<text wx:if="{{tomorrowLabel}}"> · {{tomorrowLabel}}</text></button></view>
      <view class="weather-band"><view class="weather-icon" aria-hidden="true"></view><view class="weather-copy"><view class="weather-place">{{locationLabel || '目标日天气'}}</view><view class="weather-value">{{weather && weather.status === 'known' ? weather.condition+' · '+weather.temp_min+'～'+weather.temp_max+'°C' : weatherMessage}}</view></view><button class="weather-choose" bindtap="location">地点 ›</button></view>
      <view class="criteria-row"><button class="scene-control c-dropdown" data-kind="scene" bindtap="criteria" disabled="{{!writable || dailyLoading}}">场景：{{sceneLabel || '日常'}}</button><button class="preference-control c-dropdown" data-kind="preference" bindtap="criteria" disabled="{{!writable || dailyLoading}}">{{preferenceLabel || '偏好依据'}}</button></view>
      <view wx:if="{{dailyLoading}}" class="c-meta" role="status">正在读取目标日搭配…</view>
      <view wx:if="{{unknownResult}}" class="c-note c-warning">上次保存结果尚待确认。<button bindtap="resumeSave">查看原保存结果</button></view>
      <view wx:if="{{draft && draft.main_items.length}}" class="daily-outfit">
        <view class="outfit-heading"><text>{{viewSelected ? '第 '+selectedPlan.sequence+' 套 · 已选好' : '这一套'}}</text><text wx:if="{{viewSelected}}" class="selected-person">{{selectedPlan.selected_by || '家人'}}已选</text></view>
        <view class="c-items home-items"><view wx:for="{{draft.main_items}}" wx:key="id" class="c-item" data-id="{{item.id}}" bindtap="openItem" aria-role="button" aria-label="{{viewSelected ? '查看' : '调整'}}{{item.name}}"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view wx:else class="c-photo-empty">{{item.asset_id ? '照片加载中' : '手动录入实物'}}</view><view class="c-name">{{item.name || item.categoryLabel}}</view><view class="c-label">{{item.colorLabel}} · {{item.thicknessLabel}}</view><view class="c-label">{{viewSelected ? item.fitLabel : (item.currentFitLabel || item.fitLabel)}} · {{viewSelected ? item.stateLabel : (item.currentStateLabel || item.stateLabel)}}</view><view wx:if="{{!viewSelected && item.currentIssue}}" class="c-label item-warning">{{item.currentIssue}}</view><view wx:if="{{item.fixed}}" class="c-fixed">已固定</view><button class="original-link" data-id="{{item.id}}" catchtap="preview" disabled="{{!item.asset_id}}">{{item.photoNote ? '同原图 · 查看' : '查看原图'}}</button></view></view>
        <view wx:if="{{reason}}" class="outfit-reason">{{reason}}</view><view class="outfit-basis">{{viewSelected ? '按选择时的场景和偏好准备' : '当前依据：'+sceneLabel+' · '+preferenceLabel}}</view>
        <view wx:if="{{!viewSelected && writable}}" class="outfit-adjust"><button bindtap="adjust">调整单品 ›</button></view>
        <view class="backup-entry"><view><view class="backup-heading">备用 <text>选填</text></view><view class="c-label">{{draft.backup.items.length ? '已准备 '+draft.backup.items.length+' 件'+(draft.backup.mode === 'full' ? ' · 整套' : ' · 部分单品') : '按需要准备，可只带一件'}}</view></view><button wx:if="{{draft.backup.items.length}}" bindtap="toggleBackup">{{backupExpanded ? '收起' : '查看'}} ›</button><button wx:elif="{{!viewSelected && writable}}" bindtap="adjust">添加备用 ›</button></view>
        <view wx:if="{{backupExpanded}}" class="c-items home-items backup-items"><view wx:for="{{draft.backup.items}}" wx:key="id" class="c-item"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" data-id="{{item.id}}" bindtap="preview"/><view wx:else class="c-photo-empty">{{item.asset_id ? '照片暂不可用' : '手动录入实物'}}</view><view class="c-name">{{item.name}}</view><view class="c-label">{{viewSelected ? item.fitLabel : (item.currentFitLabel || item.fitLabel)}} · {{viewSelected ? item.stateLabel : (item.currentStateLabel || item.stateLabel)}}</view><view wx:if="{{!viewSelected && item.currentIssue}}" class="c-label item-warning">{{item.currentIssue}}</view><button class="original-link" data-id="{{item.id}}" bindtap="preview" disabled="{{!item.asset_id}}">查看原图</button></view></view>
      </view>
      <view wx:if="{{draft && draft.main_items.length}}" class="outfit-notes"><view wx:for="{{warnings}}" wx:key="*this" class="c-note c-warning">{{item}}</view><view wx:for="{{missing}}" wx:key="*this" class="c-note c-warning">{{item}}</view></view>
      <view wx:if="{{!dailyLoading && (!draft || !draft.main_items.length)}}" class="c-empty"><view class="empty-title">{{role === 'viewer' ? '等待家人准备搭配' : '还没有合适的搭配'}}</view><view class="empty-copy">{{role === 'viewer' ? '家人选好后，这里会显示共享搭配。' : '把宝贝的实物衣物加入衣橱，确认可穿与合身后，就能准备搭配。'}}</view><button bindtap="wardrobe">查看衣橱</button><button wx:if="{{writable}}" class="primary" bindtap="addClothes">添加衣物</button></view>
      <button wx:if="{{resumeAvailable && writable}}" class="resume-link" bindtap="resumeDraft">继续保留中的调整 ›</button>
      <view wx:if="{{planViews.length > 1}}" class="c-title">{{targetDateLabel}} · 已选 {{planViews.length}} 套</view><view wx:if="{{planViews.length > 1}}"><view wx:for="{{planViews}}" wx:key="id" class="c-plan {{selectedPlan.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choosePlan" aria-role="button" aria-label="查看第{{item.sequence}}套"><view class="plan-photos"><view wx:for="{{item.photoItems}}" wx:for-item="photo" wx:key="id" class="plan-photo"><image wx:if="{{photo.image}}" src="{{photo.image}}" mode="aspectFit"/><text wx:else>{{photo.categoryLabel}}</text></view></view><view class="plan-copy"><view>第 {{item.sequence}} 套 · {{item.mainSummary}}</view><view class="c-label">{{item.selected_by}}已选 · {{item.backupLabel}}</view><view class="c-label">{{item.updatedLabel}}</view></view><view class="c-circle {{selectedPlan.id === item.id ? 'selected' : ''}}">{{selectedPlan.id === item.id ? '✓' : ''}}</view></view></view>
      <view wx:if="{{role === 'viewer'}}" class="c-note">当前仅可查看家人已选的搭配。</view><view wx:if="{{error}}" class="c-error" role="alert">{{error}}</view>
      <view wx:if="{{writable && contextReady && draft && draft.main_items.length}}" class="c-footer c-home-footer"><block wx:if="{{viewSelected}}"><button class="primary" bindtap="editPlan" disabled="{{busy || dailyLoading || unknownResult}}">修改这套</button><button bindtap="addPlan" disabled="{{busy || dailyLoading || unknownResult}}">新增一套</button></block><block wx:else><button bindtap="changeOutfit" disabled="{{busy || dailyLoading || unknownResult || !draft.main_items.length}}">换一套</button><button class="primary" bindtap="selectOutfit" disabled="{{busy || dailyLoading || unknownResult || !draft.main_items.length}}">选这套</button></block></view>
    </block>
  </block>
  <view class="bottom-nav"><button class="active" bindtap="home"><view class="nav-icon nav-outfit" aria-hidden="true"></view><view>搭配</view></button><button bindtap="wardrobe"><view class="nav-icon nav-wardrobe" aria-hidden="true"></view><view>衣橱</view></button><button bindtap="calendar"><text class="nav-icon nav-calendar" aria-hidden="true">▦</text><view>日历</view></button><button bindtap="my"><view class="nav-icon nav-person" aria-hidden="true"></view><view>我的</view></button></view>
  <view wx:if="{{switchSheet}}" class="switch-mask" bindtap="closeChildSwitch" catchtouchmove="noop"><view class="switch-sheet" catchtap="noop" aria-role="dialog" aria-label="切换宝贝"><view class="sheet-heading"><view class="sheet-title">切换宝贝</view><button class="sheet-close" bindtap="closeChildSwitch" aria-label="关闭切换宝贝">×</button></view><view class="sheet-meta">{{family.name || '我的家庭'}} · 今天的准备情况</view><scroll-view scroll-y class="sheet-list" style="height: {{children.length > 4 ? '46vh' : children.length * 76 + 'px'}};"><view wx:for="{{children}}" wx:key="id" class="sheet-child {{child.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose" aria-role="button" aria-label="{{item.nickname}}，{{item.todaySummary}}"><view class="child-initial">{{item.initial}}</view><view class="sheet-child-copy"><view class="sheet-child-name">{{item.nickname}}</view><view class="sheet-child-age">{{item.ageLabel}}</view><view class="sheet-child-summary">{{item.todaySummary}}</view></view><view class="c-circle {{child.id === item.id ? 'selected' : ''}}">{{child.id === item.id ? '✓' : ''}}</view><button class="sheet-edit" data-id="{{item.id}}" catchtap="editChild" aria-label="{{role === 'viewer' ? '查看' : '编辑'}}{{item.nickname}}档案">档案 ›</button></view></scroll-view><button wx:if="{{writable}}" class="sheet-add" bindtap="addChild">＋ 添加宝贝</button><button class="sheet-manage" bindtap="children">管理宝贝档案 ›</button><button class="sheet-cancel" bindtap="closeChildSwitch">取消</button></view></view>
  <view wx:if="{{criteriaSheet}}" class="c-mask" bindtap="closeCriteria" catchtouchmove="noop"><view class="c-sheet" catchtap="noop" aria-role="dialog" aria-label="本次建议条件"><view class="sheet-heading"><view class="sheet-title">{{viewSelected ? '准备一套新建议' : '本次建议条件'}}</view><button class="sheet-close" bindtap="closeCriteria" aria-label="关闭建议条件">×</button></view><view class="c-meta">{{viewSelected ? '新建议使用以下条件，已选内容保持。' : '合身、舒适与可穿情况始终参与核对。'}}</view><view class="criteria-label">活动场景</view><picker range="{{scenes}}" range-key="name" value="{{sceneIndex}}" bindchange="scene"><view class="c-dropdown">{{scenes[sceneIndex].name}}</view></picker><view class="criteria-label">偏好依据</view><picker range="{{preferenceOptions}}" value="{{preferenceIndex}}" bindchange="preference"><view class="c-dropdown">{{preferenceOptions[preferenceIndex]}}</view></picker><picker wx:if="{{preferenceIndex === 2}}" range="{{members}}" range-key="nickname" value="{{memberIndex}}" bindchange="member"><view class="c-dropdown">{{members[memberIndex].nickname || '选择成员'}}</view></picker><view class="c-actions"><button bindtap="closeCriteria">取消</button><button class="primary" bindtap="applyCriteria" disabled="{{!writable || unknownResult}}">{{viewSelected ? '准备新建议' : '按这些条件查看'}}</button></view></view></view>
</view>
