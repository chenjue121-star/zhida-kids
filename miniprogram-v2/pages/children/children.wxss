.children-page {min-height:100vh;padding:32rpx 30rpx calc(55rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#eef8ff 0%,#fff 38%);color:#1c2a38}
.children-heading {font-size:21px;font-weight:750;line-height:1.3}
.children-family {font-size:13px;color:#64758c;margin:10rpx 0 23rpx}
.child-record {position:relative;display:flex;align-items:center;gap:20rpx;min-height:154rpx;margin-bottom:20rpx;padding:20rpx;border:2rpx solid #e2e8ed;border-radius:16rpx;background:#fff}
.child-record.selected {border-color:#348b50;background:#f3faf1}
.record-avatar {display:flex;align-items:center;justify-content:center;width:90rpx;height:90rpx;flex:none;border-radius:50%;background:#e7f5e9;color:#267647;font-size:20px;font-weight:750}
.record-info {flex:1;min-width:0}
.record-name {font-size:17px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.record-age {font-size:14px;color:#5d6f85;margin-top:3rpx}
.record-measure {font-size:11px;color:#596d82;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.record-actions {display:flex;align-items:center;justify-content:flex-end;gap:8rpx;width:184rpx;flex:none}
.record-select,.record-edit {display:flex;align-items:center;justify-content:center;width:88rpx;height:88rpx;flex:none;line-height:1}
.record-select {color:#5c6c81;font-size:28px}
.record-select.is-current {color:#2d894b}
.record-edit {color:#3f744d;font-size:23px}
.children-empty {padding:60rpx 18rpx;text-align:center;color:#687993;font-size:14px}
.add-record {display:flex;align-items:center;gap:18rpx;min-height:108rpx;margin:25rpx 0 0;padding:16rpx 22rpx;border-radius:18rpx;background:#eff7ec;color:#1d3544;font-size:16px;font-weight:750}
.add-icon {width:61rpx;height:61rpx;flex:none;border-radius:50%;background:#318a4e;color:#fff;text-align:center;line-height:57rpx;font-size:27px;font-weight:400}
.add-record>view {flex:1;min-width:0}
.add-sub {font-size:11px;font-weight:400;color:#65788b;margin-top:2rpx}
.add-arrow {font-size:24px;color:#667e75}
.children-bottom {margin-top:50rpx;border-top:1rpx solid #e4eaed}
.children-bottom>view {display:flex;align-items:center;justify-content:space-between;min-height:88rpx;padding:0 8rpx;border-bottom:1rpx solid #e4eaed;background:#fff;color:#254237;font-size:14px}
.children-bottom text {font-size:23px;color:#8c9ba8}
