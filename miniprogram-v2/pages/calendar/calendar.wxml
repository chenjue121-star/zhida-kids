<view class="page d-page calendar-page">
 <view class="d-heading"><view class="title">搭配日历</view><view class="meta">回看家人已选的安排</view></view>
 <view wx:if="{{loading}}" class="loading">正在读取方案…</view><view wx:if="{{error}}" class="notice error">{{error}}<button class="link" bindtap="reload">重新读取</button></view>
 <view wx:if="{{role === 'viewer'}}" class="notice">当前仅可查看家庭已选方案。</view>
 <view class="d-filters"><picker mode="date" fields="month" value="{{month}}" bindchange="month" disabled="{{loading || busy}}"><view class="picker">{{month || '选择月份'}}</view></picker><picker range="{{childOptions}}" value="{{childIndex}}" bindchange="child" disabled="{{loading || busy}}"><view class="picker">{{childOptions[childIndex]}}</view></picker></view>
 <label class="d-toggle"><text>同时显示已撤销方案</text><switch checked="{{includeCancelled}}" color="#267a42" bindchange="cancelled"/></label>
 <block wx:if="{{ready}}">
  <scroll-view scroll-x class="calendar-scroller"><view class="calendar-board"><view class="calendar-week"><view wx:for="{{weekdays}}" wx:key="*this">{{item}}</view></view>
  <view class="calendar-grid"><button wx:for="{{cells}}" wx:key="key" class="calendar-day {{!item.date ? 'placeholder' : ''}} {{item.date === selectedDate ? 'active' : ''}} {{item.today ? 'today' : ''}}" data-date="{{item.date}}" bindtap="day" disabled="{{!item.date}}" aria-label="{{item.date ? item.date + '，已选' + item.count + '套' : ''}}"><view>{{item.day}}</view><view class="calendar-count">{{item.count ? item.count + '套' : item.cancelled ? '撤销' : ' '}}</view></button></view></view></scroll-view>
  <view class="d-day-heading"><view class="name">{{selectedLabel}}</view><view class="meta">{{dayPlans.length ? '按选定顺序回看' : '这一天暂无已选方案'}}</view></view>
  <view wx:if="{{!dayPlans.length}}" class="d-empty"><view>还没有这一天的搭配安排</view><view class="meta">从搭配页选定后，方案会自动保存在这里。</view><button class="link" bindtap="home">前往搭配</button></view>
  <button wx:for="{{dayPlans}}" wx:key="id" class="d-plan-row {{item.status === 'cancelled' ? 'cancelled' : ''}}" data-id="{{item.id}}" bindtap="detail"><view class="d-plan-title"><view>{{item.childName}} · 第 {{item.sequence}} 套</view><text class="badge">{{item.statusLabel}}</text></view><view class="d-photos"><image wx:for="{{item.photoItems}}" wx:for-item="garment" wx:key="id" wx:if="{{garment.image}}" src="{{garment.image}}" mode="aspectFit"/></view><view class="d-summary">{{item.mainSummary}}</view><view class="meta">{{item.backupLabel}} · {{item.selected_by || '家人'}}选定 <text>›</text></view></button>
  <view wx:if="{{imageMessage}}" class="meta">{{imageMessage}}</view>
 </block>
 <view class="d-honesty">这里记录已选方案；实际穿着、换洗与归还情况保持未知。</view>
 <view class="bottom-nav"><button bindtap="home"><text class="nav-icon">⌂</text><view>搭配</view></button><button bindtap="wardrobe"><text class="nav-icon">▥</text><view>衣橱</view></button><button class="active" bindtap="calendar"><text class="nav-icon">▦</text><view>日历</view></button><button bindtap="my"><text class="nav-icon">♙</text><view>我的</view></button></view>
</view>
