@import "../../b.wxss";
.b-detail-page .b-detail-hero{position:relative;margin:11px 0 12px;min-height:182px;border-radius:8px;overflow:hidden;background:#f4f6f2}
.b-detail-page .b-original{display:block;border-radius:8px}
.b-detail-page .b-no-image{height:182px;display:flex;align-items:center;justify-content:center}
.b-detail-page .b-origin-button{position:absolute;right:6px;bottom:6px;padding:6px 9px;font-size:11px;background:rgba(255,255,255,.96);border:1px solid #d2dfd4;font-weight:500;box-shadow:none}
.b-title-row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.b-title-row .b-detail-name{flex:1;min-width:0;font-size:19px;line-height:1.3;margin:0;font-weight:750}
.b-title-row picker{flex:none;min-width:68px}
.b-status-select{font-size:12px;font-weight:500;border-radius:8px;min-width:68px;background-color:#eef6f0;color:#267a42;border-color:#c8dccb}
.b-status-select.washing{background-color:#fff5df;color:#875619;border-color:#dec697}
.b-status-select.missing{background-color:#fbefed;color:#936158;border-color:#e1c4be}
.b-detail-meta{font-size:11px;color:#64736a;line-height:1.7;margin:5px 0 9px}
.b-detail-page .b-info-row{font-size:12px;min-height:39px}
.b-owner-heading{display:flex;justify-content:space-between;gap:9px;font-size:12px;margin:14px 0 0}
.b-owner-heading text{font-size:10px;color:#64736a;font-weight:400}
.b-detail-owner{display:flex;gap:9px;align-items:center;min-height:55px;border-bottom:1px solid #e4ebe3}
.b-detail-owner .b-initial{width:33px;height:33px;font-size:14px;flex:none}
.b-owner-copy{flex:1;min-width:0;font-size:12px;font-weight:650}
.b-owner-age{font-size:10px;color:#64736a;font-weight:400;margin-top:2px}
.b-detail-owner>text{font-size:11px;color:#267a42;flex:none}
.b-ownership-links{display:flex;justify-content:space-between;gap:12px}
.b-ownership-links button{font-size:12px;font-weight:500;background:transparent;padding:7px 0;box-shadow:none}
.b-ownership-links .b-danger-link{color:#a83532;margin-left:auto}
.b-detail-footer{flex-direction:column;gap:7px}
.b-footer-note{font-size:10px;color:#64736a;line-height:1.5;text-align:center;width:100%}
.b-footer-actions{display:flex;gap:9px;width:100%}
.b-footer-actions button{flex:1}
.b-detail-footer>button{width:100%}
.b-secondary{background:white;border:1px solid #c8dccb;color:#267a42;box-shadow:none}
