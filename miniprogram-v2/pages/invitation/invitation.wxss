.invitation-page .header {margin-bottom:4px}
.invitation-page .invitation-content {border:0;padding-top:0;text-align:center;margin-top:0}
.invitation-house {display:block;width:265px;max-width:100%;height:200px;margin:0 auto 4px}
.invite-from {font-size:16px;font-weight:650}
.invite-family {font-size:24px;font-weight:750;color:#277e42;margin:5px 0 20px}
.invite-role {display:flex;justify-content:space-between;gap:8px;padding:15px;border:1px solid #dfe6ed;border-radius:9px;text-align:left;font-size:14px}
.invite-role text:last-child {font-weight:700}
.invite-expiry {margin:13px 0 17px}
.invitation-content .actions button {width:100%}
.invitation-page > button.link {display:block;text-align:center;margin:10px auto 0;color:#536b80}
.invitation-unavailable {padding:80px 0 20px;text-align:center}
.unavailable-icon {display:flex;align-items:center;justify-content:center;width:54px;height:54px;margin:0 auto 19px;border-radius:50%;background:#fff1e8;color:#ae6740;font-size:27px;font-weight:700}
.unavailable-title {margin-bottom:8px;font-size:18px;font-weight:750}
.invitation-unavailable .primary {width:100%;margin-top:29px}
