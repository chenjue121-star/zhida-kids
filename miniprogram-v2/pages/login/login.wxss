.login-page {display:flex;flex-direction:column;align-items:center;text-align:center;background:linear-gradient(180deg,#eaf7ff 0%,#fff 55%)}
.login-brand-row {display:flex;align-items:center;gap:8px;margin-top:35px}
.login-logo {width:38px;height:38px;border-radius:10px;background:#e6f4e9;color:#2a8045;display:flex;align-items:center;justify-content:center;font-size:26px}
.login-brand {margin:0;font-size:27px}
.login-illustration {width:100%;max-width:330px;height:265px;margin:32px 0 8px}
.login-title {font-size:25px;font-weight:750}
.login-page .subtitle {font-size:14px;max-width:270px}
.login-page .section {border:0;width:100%;padding-top:0;margin-top:35px}
.login-page .section button.primary {width:100%}
