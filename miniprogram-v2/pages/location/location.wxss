.city-page {min-height:100vh;padding:28px 20px calc(32px + env(safe-area-inset-bottom));background:#fff}
.city-header {padding:12px 0 20px;text-align:center}
.city-marker {width:74px;height:74px;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;border-radius:50%;background:#eaf6eb;color:#2c8246;font-size:46px;line-height:1}
.city-title {font-size:23px;font-weight:750}
.city-copy {max-width:285px;margin:7px auto 0;color:#61758a;font-size:14px;line-height:1.55}
.auto-location {min-height:79px;display:flex;align-items:center;gap:13px;padding:13px 16px;border-radius:12px;background:#edf8ef;color:#233f30}
.locate-icon {width:44px;height:44px;display:flex;align-items:center;justify-content:center;flex:none;border-radius:50%;background:#d6eedb;color:#2b8547;font-size:27px}
.auto-title {font-size:16px;font-weight:700}
.auto-copy {font-size:12px;color:#55725e;margin-top:1px}
.auto-arrow {margin-left:auto;color:#2b8348;font-size:27px}
.city-divider {display:flex;align-items:center;gap:12px;color:#61758a;font-size:13px;margin:24px 0}
.city-divider::before,.city-divider::after {content:"";height:1px;flex:1;background:#dfe7ed}
.city-label {font-weight:700;font-size:15px;margin-bottom:9px}
.search-row {display:flex;align-items:center;gap:10px}
.search-row input {flex:1;min-width:0;background:#fff;height:46px}
.search-row button {width:85px;flex:none;margin:0;background:#267a42;color:#fff;min-height:46px;padding:8px}
.city-result {display:flex;justify-content:space-between;gap:10px;padding:15px 4px;border-bottom:1px solid #e4ebee;font-size:15px}
.city-result.selected {color:#247b43;font-weight:700}
.city-result text:last-child {color:#667c90;text-align:right}
.city-save {min-height:48px;display:flex;align-items:center;justify-content:center;margin:26px 0 0;padding:9px;border-radius:9px;background:#267a42;color:#fff;font-size:15px;font-weight:700;text-align:center}
.city-save[disabled] {background:#e8eeeb;color:#66776b}
.city-hint {font-size:12px;color:#5d7288;margin-top:16px;line-height:1.5}
