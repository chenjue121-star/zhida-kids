<view class="b-page">
 <view wx:if="{{loading && !ready}}" class="loading">正在恢复录入进度…</view><view wx:if="{{error}}" class="notice error">{{error}}<button wx:if="{{accessRevoked}}" bindtap="goFamilies">选择家庭</button><button wx:elif="{{writable}}" bindtap="reload" disabled="{{loading}}">重新读取进度</button></view>
 <block wx:if="{{ready && writable}}">
  <view class="b-default"><view class="b-muted">{{batch ? '本批默认宝贝已固定' : '开始前选择默认宝贝'}}</view><picker disabled="{{!!batch || creating || picking}}" range="{{children}}" range-key="nickname" bindchange="defaultChild"><view class="b-select">{{defaultChild ? defaultChild.nickname : '请先添加宝贝'}}</view></picker></view>
  <view class="actions"><button class="primary" bindtap="camera" disabled="{{picking || !defaultChild}}">{{photos.length ? '继续拍一张' : '拍照录入'}}</button><button bindtap="album" disabled="{{picking || !defaultChild}}">相册多选</button></view>
  <view class="b-note">可以先拍一批，识别期间继续添加。多件图需要勾选实际拥有的单品，确认前不会放进衣橱。</view>
  <view class="b-summary">{{photos.length}} 张照片 · {{candidateCount}} 件待核对候选</view>
  <view wx:for="{{photos}}" wx:key="client_id" class="b-photo-row"><image wx:if="{{item.local_path || item.image}}" src="{{item.local_path || item.image}}" mode="aspectFit" data-asset="{{item.asset_id}}" data-path="{{item.local_path}}" bindtap="preview"/><view wx:else class="photo-placeholder"></view><view class="b-photo-copy"><view>{{item.sourceLabel}} · {{item.statusLabel}}{{item.multi ? ' · 多件' : ''}}</view><view class="b-muted">{{item.candidateCount}} 件候选待确认{{item.multi ? '，下一步选择拥有的' : ''}}</view><view class="b-muted">{{item.asset_id ? '云端照片已保存，可恢复' : item.local_saved ? '本机已保存，可在同设备续传' : '尚未持久保存，退出可能丢失'}}</view><view wx:if="{{item.error}}" class="b-muted">{{item.error}}</view><button wx:if="{{item.asset_id || item.local_path}}" class="link" data-asset="{{item.asset_id}}" data-path="{{item.local_path}}" bindtap="preview">查看完整原图</button><view class="actions"><button wx:if="{{item.status === 'failed' || item.status === 'uploadFailed'}}" data-id="{{item.item_id}}" data-client="{{item.client_id}}" bindtap="retry">{{item.asset_id ? '重试识别' : '续传照片'}}</button><button wx:if="{{item.item_id}}" data-id="{{item.item_id}}" bindtap="manual">手填单品</button><button wx:if="{{item.item_id}}" class="link" data-id="{{item.item_id}}" bindtap="discard">放弃照片</button></view></view></view>
  <view wx:for="{{manualDrafts}}" wx:key="id" class="b-photo-row"><view class="b-photo-copy"><view>手动补充 · 尚未填写</view><view class="b-muted">这次补充已保留，继续填写同一件候选即可。</view><view class="actions"><button data-id="{{item.id}}" bindtap="manual" disabled="{{busy}}">继续填写</button><button class="link" data-id="{{item.id}}" bindtap="discard" disabled="{{busy}}">放弃补充</button></view></view></view>
  <button class="link" bindtap="manual" disabled="{{busy || !defaultChild}}">不拍照，手动补充一件</button>
  <view wx:if="{{!photos.length}}" class="b-empty"><image src="/assets/outfit-flatlay.png" mode="aspectFit"/><view class="b-empty-copy">挂拍、平铺都可以，尽量拍清整件衣物。</view></view>
  <view class="b-fixed"><button bindtap="back">稍后继续</button><button class="primary" bindtap="confirm" disabled="{{!batch}}">查看候选 · {{candidateCount}}</button></view>
 </block>
</view>
