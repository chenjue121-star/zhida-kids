@import "../../b.wxss";
.b-candidate-row{display:flex;align-items:flex-start;gap:8px;padding:12px 0;border-bottom:1px solid #e7ede7}
.b-candidate-image,.b-candidate-placeholder{width:57px;height:73px;flex-shrink:0;display:block;border-radius:7px;background:#f4f6f1}
.b-candidate-check{width:20px;min-height:44px;flex-shrink:0;align-items:flex-start;padding-top:2px}
.b-candidate-check checkbox{width:44px;height:44px;left:-16px;right:auto}
.b-candidate-copy{flex:1;min-width:0}
.b-candidate-name{font-size:14px;font-weight:650;line-height:1.45;overflow-wrap:anywhere}
.b-candidate-source{font-size:11px;line-height:1.5;color:#738477;margin:2px 0}
.b-candidate-meta{font-size:12px;line-height:1.6;color:#62756a;overflow-wrap:anywhere}
.b-page .b-candidate-original{min-height:44px;padding:6px 0;text-align:left;font-size:11px;font-weight:500;background:transparent;line-height:1.5}
.b-page .b-candidate-review{width:44px;min-height:44px;flex-shrink:0;padding:0;background:transparent;font-size:12px;font-weight:500;color:#267a42}
