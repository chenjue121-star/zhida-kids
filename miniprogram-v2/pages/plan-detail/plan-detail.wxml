<view class="page d-page">
 <view class="d-heading"><view class="title">已选方案</view><view class="meta">原方案快照 · 家庭共享</view></view>
 <view wx:if="{{loading}}" class="loading">正在读取方案…</view><view wx:if="{{error}}" class="notice error">{{error}}<button class="link" bindtap="reload" disabled="{{busy}}">重新读取</button></view>
 <view wx:if="{{ready && role === 'viewer'}}" class="notice">当前仅可查看，修改、撤销和反馈需要编辑权限。</view>
 <block wx:if="{{ready && sourceView}}">
  <view class="d-section"><view class="row"><view class="name">{{childName}} · 第 {{plan.sequence}} 套</view><text class="badge">{{sourceView.statusLabel}}</text></view><view class="meta">{{dateLabel}} · {{sceneLabel}}</view><view class="meta">{{plan.selected_by || '家人'}}选定 · {{preferenceLabel}}</view></view>
  <view class="d-section"><view class="d-section-title">主搭配</view><view wx:for="{{sourceView.main_items}}" wx:key="garment_id" class="d-garment" data-id="{{item.garment_id}}" bindtap="preview"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view wx:else class="d-garment-placeholder">原图未加载</view><view class="grow"><view class="name">{{item.name}}</view><view class="meta">{{item.categoryLabel}} · {{item.thicknessLabel}}</view><view wx:if="{{item.photoNote}}" class="meta">{{item.photoNote}}</view></view></view></view>
  <view class="d-section"><view class="d-section-title">{{plan.backup.mode === 'none' ? '无备用' : plan.backup.mode === 'full' ? '整套备用' : '局部备用'}}</view><view wx:for="{{sourceView.backup.items}}" wx:key="garment_id" class="d-garment" data-id="{{item.garment_id}}" bindtap="preview"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><view wx:else class="d-garment-placeholder">原图未加载</view><view class="grow"><view class="name">{{item.name}}</view><view class="meta">{{item.categoryLabel}} · {{item.thicknessLabel}}</view></view></view></view>
  <view class="d-source">选择时天气：{{plan.weather.status === 'known' ? plan.weather.temp_min + '–' + plan.weather.temp_max + '℃' : '未知'}}。复用时重新核对目标日天气。</view>
  <view wx:if="{{imageMessage}}" class="meta">{{imageMessage}}</view>
  <view wx:if="{{cancelPending}}" class="notice">撤销结果待确认，原方案仍保留。<button class="link" bindtap="queryCancel" disabled="{{busy || loading}}">查询原撤销结果</button><button wx:if="{{writable}}" class="link" bindtap="resolveCancel" disabled="{{busy || loading}}">核实原操作是否执行</button></view>
  <view wx:if="{{writable && plan.status !== 'cancelled' && !cancelPending}}" class="d-actions"><button bindtap="editPlan" disabled="{{busy || loading}}">修改原方案</button><button class="primary" bindtap="openReuse" disabled="{{busy || loading}}">再次使用</button><button data-signal="like" bindtap="openFeedback" disabled="{{busy || loading}}">喜欢这套</button><button data-signal="dislike" bindtap="openFeedback" disabled="{{busy || loading}}">不喜欢这套</button></view>
  <button wx:if="{{writable && plan.status !== 'cancelled' && !cancelPending}}" class="link d-error" bindtap="cancelPlan" disabled="{{busy || loading}}">撤销这套方案</button>
  <view wx:if="{{plan.status === 'cancelled'}}" class="notice">方案已撤销，主件和备用的使用安排已释放，原快照保留。</view><button wx:if="{{writable && plan.status === 'cancelled' && !cancelPending}}" class="primary" bindtap="openReuse" disabled="{{busy || loading}}">从这套历史方案再次准备</button>
  <view wx:if="{{feedbackMessage}}" class="notice">{{feedbackMessage}}<button class="link" bindtap="preferences">查看穿衣偏好</button></view>
 </block>
 <view class="d-honesty">已选记录是家长的计划。实际穿着、换洗与归还情况保持未知。</view>
 <view class="bottom-nav"><button bindtap="home"><text class="nav-icon">⌂</text><view>搭配</view></button><button bindtap="wardrobe"><text class="nav-icon">▥</text><view>衣橱</view></button><button class="active" bindtap="calendar"><text class="nav-icon">▦</text><view>日历</view></button><button bindtap="my"><text class="nav-icon">♙</text><view>我的</view></button></view>
 <view wx:if="{{reuseOpen && writable}}" class="d-sheet-mask" bindtap="closeReuse"><view class="d-sheet" catchtap="noop"><view class="d-sheet-heading"><view class="name">从旧方案准备新搭配</view><button bindtap="closeReuse" aria-label="关闭复用">×</button></view><view class="d-source">给同一宝贝重新准备。来源：{{dateLabel}} · 第 {{plan.sequence}} 套，原快照会保留。</view><view class="field"><text class="field-label">目标日期</text><picker mode="date" value="{{reuseDate}}" bindchange="reuseDate" disabled="{{busy}}"><view class="picker">{{reuseDate}}</view></picker></view><view class="field"><text class="field-label">这次的偏好依据</text><picker range="{{reuseModes}}" value="{{reuseModeIndex}}" bindchange="reuseMode" disabled="{{busy}}"><view class="picker">{{reuseModes[reuseModeIndex]}}</view></picker></view><button bindtap="prepareReuse" disabled="{{busy}}" loading="{{busy}}">核对当前条件</button>
  <block wx:if="{{reuseResult}}"><view class="section-title">当前条件</view><view class="d-current">{{reuseWeatherMessage}}</view><view wx:for="{{reuseIssues}}" wx:key="id" class="d-warning"><view>{{item.name}}</view><view>{{item.message}}</view><view wx:if="{{item.changed}}">选择时第 {{item.sourceVersion}} 版 → 当前第 {{item.currentVersion}} 版</view></view><view wx:for="{{reuseMissing}}" wx:key="*this" class="d-warning">{{item}}</view><view wx:for="{{reuseWarnings}}" wx:key="*this" class="d-warning">{{item}}</view><checkbox-group wx:if="{{reuseChanged}}" bindchange="acknowledgeReuse"><label class="choice"><checkbox value="ack" checked="{{reuseAcknowledged}}" color="#267a42"/><text>已核对更新后的衣物资料，使用当前资料准备新草稿</text></label></checkbox-group><view class="meta">这里先准备草稿。进入确认页后需核对主件、备用和共用安排，再明确选定。</view><button class="primary" bindtap="confirmReuse" disabled="{{busy || (reuseChanged && !reuseAcknowledged)}}">继续核对新搭配</button></block><view wx:if="{{error}}" class="notice error">{{error}}</view>
 </view></view>
 <view wx:if="{{feedbackOpen && writable}}" class="d-sheet-mask" bindtap="closeFeedback"><view class="d-sheet" catchtap="noop"><view class="d-sheet-heading"><view class="name">{{feedbackSignal === 'like' ? '喜欢这套搭配' : '不喜欢这套搭配'}}</view><button bindtap="closeFeedback" aria-label="关闭反馈">×</button></view><view class="d-source">{{plan.preference_subject.mode === 'family' ? '这次反馈用于家庭共同偏好。' : '这次反馈用于我的个人偏好。'}}</view><view class="field"><text class="field-label">原因（选填）</text><picker range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="feedbackReason" disabled="{{busy || feedbackFrozen}}"><view class="picker">{{reasons[reasonIndex].label}}</view></picker></view><view class="d-warning">舒适、待洗、找不到、偏小或未说明原因，不会推断长期审美偏好。</view><view wx:if="{{reasons[reasonIndex].key === 'aesthetic'}}"><view class="field-label">涉及哪些风格（选填）</view><checkbox-group bindchange="feedbackStyles"><label wx:for="{{styleOptions}}" wx:key="key" class="choice"><checkbox value="{{item.key}}" checked="{{item.checked}}" color="#267a42" disabled="{{busy || feedbackFrozen}}"/><text>{{item.label}}</text></label></checkbox-group></view><view wx:if="{{feedbackFrozen}}" class="notice">原反馈结果待确认，内容已冻结。重试会使用同一反馈身份。</view><view wx:if="{{error}}" class="notice error">{{error}}</view><button class="primary" bindtap="sendFeedback" disabled="{{busy}}" loading="{{busy}}">{{feedbackFrozen ? '重试原反馈' : '保存反馈'}}</button></view></view>
</view>
