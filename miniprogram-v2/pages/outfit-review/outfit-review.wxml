<template name="review-pieces">
  <view class="review-pieces">
    <view wx:for="{{items}}" wx:key="id" class="review-piece">
      <button class="review-photo" data-id="{{item.id}}" data-view="{{view}}" bindtap="preview" disabled="{{!item.asset_id}}" aria-label="查看{{item.name}}的完整原图">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/>
        <view wx:else class="review-photo-empty">{{item.asset_id ? '照片加载中' : '手动录入实物'}}</view>
        <text wx:if="{{item.asset_id}}" class="review-photo-tag">{{item.photoLabel}}</text>
      </button>
      <view class="review-piece-name">{{item.name}}</view>
      <view wx:if="{{item.category}}" class="review-piece-meta">{{item.categoryLabel}} · {{item.thicknessLabel}}</view>
      <view wx:if="{{item.currentIssue}}" class="review-item-warning">{{item.currentIssue}}</view>
      <view wx:if="{{item.compatibilityLabel}}" class="review-piece-meta">{{item.compatibilityLabel}}</view>
    </view>
  </view>
</template>
<template name="review-arrangements">
  <view wx:if="{{arrangements.length}}" class="review-section"><view class="review-section-title">{{title}}</view><view wx:for="{{arrangements}}" wx:key="garment_id" class="c-note"><view class="review-section-title">{{item.name}}</view><view wx:for="{{item.periods}}" wx:for-item="period" wx:key="child_id" class="review-period-summary">{{period.nickname}} · {{period.label}}</view><view class="review-basis">理由：{{item.reason}}</view><view wx:for="{{item.sources}}" wx:for-item="source" wx:key="source_key" class="review-source">{{source.nickname}} · 第 {{source.sequence}} 套 · {{source.usageLabel}}<view>{{source.target_date}} · {{source.selected_by || '家人'}}已选</view></view></view></view>
</template>
<view class="c-page review-page">
  <view class="review-top"><button class="review-back" bindtap="back">‹ 返回</button><view class="review-title">{{unknownResult ? '保存结果' : completedPlan ? '这次已选好' : '核对这套'}}</view><view class="review-top-spacer"></view></view>
  <view wx:if="{{reviewIdentity}}" class="review-child"><view class="review-initial">{{reviewIdentity.childInitial}}</view><view class="review-child-copy"><view class="review-child-name">{{reviewIdentity.childNickname}}</view><view class="review-child-age">{{reviewIdentity.childAge}}</view></view><text class="review-badge">{{completedPlan ? '已选' : unknownResult ? '确认中' : '未保存'}}</text></view>
  <view wx:if="{{reviewIdentity}}" class="review-context"><view class="review-date">{{reviewIdentity.dateLabel}} · {{reviewIdentity.sceneLabel}}</view><view class="review-basis">参考{{reviewIdentity.preferenceLabel}}</view></view>
  <view wx:if="{{!ready && loading}}" class="review-skeleton" aria-label="正在读取核对内容"><view></view><view></view><view></view></view>
  <view wx:if="{{loading || busy}}" class="review-status" role="status">{{unknownResult ? '正在查看这次保存结果…' : completedPlan ? '正在读取当前已选安排…' : busy ? '正在保存这套…' : '正在核对衣物与安排…'}}</view>
  <view wx:if="{{error}}" class="c-error" role="alert">{{error}}</view>
  <view wx:if="{{imageMessage && ready}}" class="review-basis">{{imageMessage}}</view>
  <view wx:if="{{accessRevoked}}" class="c-note c-warning"><view class="review-section-title">家庭访问已失效</view><view>已清除这个家庭的搭配内容，可选择其他家庭继续。</view><button bindtap="goFamilies">选择其他家庭</button></view>
  <view wx:if="{{ready && !writable && !unknownResult && !completedPlan}}" class="c-note">当前仅可查看，不能调整或选定。<button bindtap="home">查看家人已选</button></view>

  <block wx:if="{{completedPlan}}">
    <view class="review-intent"><view class="review-section-title">已选好 · 第 {{completedPlan.sequence}} 套</view><text class="review-badge">家人可查看</text></view>
    <view class="review-basis">{{completedPlan.selected_by || '家人'}}已选。这是计划安排，使用前仍需核对衣物。</view>
    <view class="review-section-title">这次选定的主搭配</view>
    <template is="review-pieces" data="{{items:completedView.main_items,view:'completedView'}}"/>
    <view class="review-section"><view class="review-section-title">{{completedView.backupLabel}}</view><template wx:if="{{completedView.backup.items.length}}" is="review-pieces" data="{{items:completedView.backup.items,view:'completedView'}}"/><view wx:else class="review-basis">这次没有选备用。</view></view>
    <template is="review-arrangements" data="{{arrangements:sharingSummary,title:'这次选定的分时安排'}}"/>
    <view wx:if="{{completedPlan.weather.status !== 'known'}}" class="c-note c-warning">选定时未获取目标日天气，使用前请家长核对适宜性。</view>
    <view wx:if="{{currentNotes.length}}" class="review-section"><view class="review-section-title">使用前需核对</view><view wx:for="{{currentNotes}}" wx:key="*this" class="c-note c-warning">{{item}}</view></view>
    <view wx:if="{{latestView}}" class="review-section"><view class="review-section-title">家人后来的当前已选安排</view><view class="review-basis">第 {{latestView.sequence}} 套 · {{latestView.selected_by || '家人'}}已选</view><template is="review-pieces" data="{{items:latestView.main_items,view:'latestView'}}"/><view class="review-section-title">{{latestView.backupLabel}}</view><template wx:if="{{latestView.backup.items.length}}" is="review-pieces" data="{{items:latestView.backup.items,view:'latestView'}}"/></view>
    <view class="c-footer review-footer"><button class="primary" bindtap="home">回到搭配</button></view>
  </block>
  <block wx:elif="{{unknownResult}}">
    <view class="review-intent"><view class="review-section-title">正在确认保存结果</view><text class="review-badge">请先查看结果</text></view>
    <view class="review-basis">{{reviewIdentity.intentTitle}} · 以下是这次提交的内容。</view>
    <template is="review-pieces" data="{{items:reviewSnapshot.main_items,view:'reviewSnapshot'}}"/>
    <view class="review-section"><view class="review-section-title">{{reviewSnapshot.backupLabel}}</view><template wx:if="{{reviewSnapshot.backup.items.length}}" is="review-pieces" data="{{items:reviewSnapshot.backup.items,view:'reviewSnapshot'}}"/><view wx:else class="review-basis">没有提交备用。</view></view>
    <template is="review-arrangements" data="{{arrangements:sharingSummary,title:'这次提交的分时安排'}}"/>
    <view class="c-note c-warning">回复尚未收到，结果还不确定。这份提交内容已保留；查不到时仍需继续查看，避免重复新增或修改。</view>
    <view class="review-basis">可以返回保留草稿。这次结果明确前，请先不要再次保存。</view>
    <button wx:if="{{writable}}" class="review-link" bindtap="resolve" disabled="{{busy || loading}}">核实这次是否已保存 ›</button>
    <view class="c-footer review-footer"><button bindtap="back">保留草稿</button><button class="primary" bindtap="query" disabled="{{busy || loading}}">查看保存结果</button></view>
  </block>
  <block wx:elif="{{reviewSnapshot}}">
    <view class="review-intent"><view class="review-section-title">{{reviewIdentity.intentTitle}}</view><text class="review-badge">{{reviewIdentity.intentLabel}}</text></view>
    <template is="review-pieces" data="{{items:reviewSnapshot.main_items,view:'reviewSnapshot'}}"/>
    <view wx:if="{{reviewSnapshot.source === 'basic'}}" class="review-basis">使用基础建议，已按同样的衣物条件筛选；选定前仍需核对。</view>
    <view wx:if="{{reviewSnapshot.reason}}" class="review-basis">{{reviewSnapshot.reason}}</view>
    <view class="review-section"><view class="review-section-title">{{reviewSnapshot.backupLabel}}</view><template wx:if="{{reviewSnapshot.backup.items.length}}" is="review-pieces" data="{{items:reviewSnapshot.backup.items,view:'reviewSnapshot'}}"/><view wx:else class="review-basis">不准备备用也可以选定。</view><view wx:if="{{reviewSnapshot.backup.items.length}}" class="review-basis">备用属于这一套，不另算一套；沿用主搭配的实物只装一次。</view></view>
    <view wx:if="{{draft.backup_staging}}" class="c-note c-warning">备用还有未确认的暂存选择。<button bindtap="edit" disabled="{{!writable}}">返回确认或取消备用</button></view>
    <view wx:if="{{draft.backup_needs_review}}" class="c-note c-warning">主搭配已调整，备用需要重新核对。<view class="c-actions"><button bindtap="edit" disabled="{{!writable}}">重新核对备用</button><button bindtap="removeBackup" disabled="{{!writable}}">移除这次备用</button></view></view>
    <view wx:for="{{review.warnings}}" wx:key="*this" class="c-note c-warning">{{item}}</view>
    <view wx:for="{{review.missing}}" wx:key="*this" class="c-note c-warning">{{item}}</view>
    <view wx:if="{{review.missing.length}}" class="review-links"><button bindtap="edit" disabled="{{!writable || busy}}">回去调整衣物</button><button bindtap="wardrobe">查看衣橱状态</button></view>
    <view wx:if="{{weatherUnknown}}" class="c-note c-warning"><view class="review-section-title">目标日天气还未获取</view><view>需家长核对这套衣物的适宜性，当前无法确认已适合当天天气。</view><button class="review-ack {{weatherAcknowledged ? 'acknowledged' : ''}}" bindtap="weatherAck" disabled="{{!writable || busy || notSaved}}" aria-label="{{weatherAcknowledged ? '撤回天气核对确认' : '确认已核对目标日衣物适宜性'}}"><view class="c-circle {{weatherAcknowledged ? 'selected' : ''}}">{{weatherAcknowledged ? '✓' : ''}}</view><text>{{weatherAcknowledged ? '我已核对，继续选定' : '我核对过衣物后，确认继续'}}</text></button></view>
    <view wx:elif="{{weather}}" class="review-weather">目标日预报：{{weather.condition}} · {{weather.temp_min}}～{{weather.temp_max}}°C</view>

    <view wx:for="{{review.conflicts}}" wx:key="garment_id" class="review-section review-sharing"><view class="review-sharing-garment"><button class="review-mini-photo" data-id="{{item.garment.id}}" bindtap="preview" disabled="{{!item.garment.asset_id}}" aria-label="查看{{item.garment.name}}原图"><image wx:if="{{item.garment.image}}" src="{{item.garment.image}}" mode="aspectFit"/><text wx:else>{{item.garment.categoryLabel || '衣物'}}</text></button><view><view class="review-section-title">{{item.garment.name}} · {{item.resolved ? '已确认分时' : '需要核对安排'}}</view><view class="review-basis">本套{{item.usageLabel}} · 同一件实物</view></view></view>
      <view wx:for="{{item.sources}}" wx:for-item="source" wx:key="source_key" class="review-source"><view class="review-source-main">{{source.nickname}} · 第 {{source.sequence}} 套<text class="review-use">{{source.usageLabel}}</text></view><view>{{source.target_date}} · {{source.selected_by || '家人'}}已选</view><view>{{source.periodLabel}}</view></view>
      <view class="review-basis">这是计划安排，不表示已穿过、归还或洗好。</view><view wx:if="{{!item.resolved}}" class="c-actions"><button bindtap="edit" disabled="{{!writable || busy}}">换可用衣物</button><button data-id="{{item.garment_id}}" bindtap="openSharing" disabled="{{!writable || busy}}">安排分时</button></view>
    </view>
    <view wx:for="{{sharingSummary}}" wx:key="garment_id" class="c-note"><view class="review-section-title">{{item.name}} · 已确认分时</view><view wx:for="{{item.periods}}" wx:for-item="period" wx:key="child_id" class="review-period-summary">{{period.nickname}} · {{period.label}}</view><view class="review-basis">理由：{{item.reason}}</view><button data-id="{{item.garment_id}}" bindtap="openSharing" disabled="{{!writable || busy}}">调整分时安排</button></view>
    <view wx:if="{{reservationChanges}}" class="review-section"><view class="review-section-title">保存成功后，本套使用的变化</view><view class="review-change-row"><text>保留使用</text><view><view wx:for="{{reservationChanges.kept}}" wx:key="usageKey">{{item.name}}（{{item.usageLabel}}）</view><text wx:if="{{!reservationChanges.kept.length}}">无</text></view></view><view class="review-change-row"><text>新增使用</text><view><view wx:for="{{reservationChanges.added}}" wx:key="usageKey">{{item.name}}（{{item.usageLabel}}）</view><text wx:if="{{!reservationChanges.added.length}}">无</text></view></view><view class="review-change-row"><text>这套不再使用</text><view><view wx:for="{{reservationChanges.removed}}" wx:key="usageKey">{{item.name}}（{{item.usageLabel}}）</view><text wx:if="{{!reservationChanges.removed.length}}">无</text></view></view><view class="review-basis">保存成功前原安排保留；其他方案仍在使用的衣物，会继续保留它们的安排。</view></view>
    <view class="review-section"><view class="review-section-title">打包清单 · {{packingItems.length}} 件实物</view><view wx:for="{{packingItems}}" wx:key="id" class="review-pack-row"><button class="review-mini-photo" data-id="{{item.id}}" bindtap="preview" disabled="{{!item.asset_id}}" aria-label="查看{{item.name}}原图"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"/><text wx:else>{{item.categoryLabel || '衣物'}}</text></button><view class="review-pack-copy"><view>{{item.name}}</view><view class="review-basis">{{item.usesLabel}}</view></view></view><view class="review-basis">同件主备只计一次；同图里的不同衣物分别计数。鞋按一双计。</view></view>
    <view class="review-statement">{{reviewIdentity.intentNote}}</view>
    <view wx:if="{{conflict}}" class="c-note c-warning"><view class="review-section-title">家人已更新这套</view><view>你的草稿已保留，暂不能覆盖家人最新的已选内容。</view><view class="c-actions"><button bindtap="compare">看最新对比</button><button bindtap="asNew" disabled="{{!writable || busy}}">改为新增</button></view></view>
    <view wx:if="{{notSaved}}" class="c-note c-warning"><view class="review-section-title">这次未保存，草稿已保留</view><button class="primary" bindtap="resumeReview" disabled="{{!writable || busy}}">重新核对草稿</button></view>
    <view wx:elif="{{writable}}" class="review-links"><button bindtap="edit" disabled="{{busy}}">继续调整衣物 ›</button><button bindtap="latestGarments" disabled="{{busy || loading}}">核对最新衣物资料 ›</button><button bindtap="preflight" disabled="{{busy || loading}}">重新核对当前条件 ›</button></view>
    <view class="c-footer review-footer"><button bindtap="back" disabled="{{busy}}">取消核对</button><button class="primary" bindtap="save" disabled="{{!writable || busy || loading || notSaved || sharingDirty || sharingOpen || garmentReviewOpen || draft.backup_staging || draft.backup_needs_review || !review.valid || (weatherUnknown && !weatherAcknowledged)}}">{{draft.target_plan_id ? '保存修改' : '新增这套'}}</button></view>
  </block>
  <view wx:if="{{ready && !reviewSnapshot && !completedPlan && !unknownResult}}" class="c-empty">{{writable ? '当前没有可核对的草稿，请回到搭配准备。' : '可回到搭配查看家人已选的内容。'}}<button bindtap="home">回到搭配</button></view>
  <view class="review-nav"><button class="active" bindtap="home"><view class="review-nav-icon review-nav-outfit" aria-hidden="true"></view><view>搭配</view></button><button bindtap="wardrobe"><view class="review-nav-icon review-nav-wardrobe" aria-hidden="true"></view><view>衣橱</view></button><button bindtap="my"><view class="review-nav-icon review-nav-person" aria-hidden="true"></view><view>我的</view></button></view>

  <view wx:if="{{sharingOpen}}" class="c-mask" bindtap="cancelSharing" catchtouchmove="noop"><view class="c-sheet review-sheet" catchtap="noop" aria-role="dialog" aria-label="分时安排"><view class="review-sheet-heading"><view class="review-section-title">分时安排</view><button class="review-close" bindtap="cancelSharing" aria-label="关闭分时安排">×</button></view><scroll-view scroll-y class="review-sheet-scroll"><view class="review-sharing-garment"><button class="review-mini-photo" data-id="{{sharingGarment.id}}" bindtap="preview" disabled="{{!sharingGarment.asset_id}}"><image wx:if="{{sharingGarment.image}}" src="{{sharingGarment.image}}" mode="aspectFit"/><text wx:else>衣物</text></button><view><view>{{sharingGarment.name}} · 同一件实物</view><view class="review-basis">按安排分时使用，不表示已穿或已洗好。</view></view></view><view class="review-section-title">这次核对全部 {{sharingSources.length}} 条已选来源</view><view wx:for="{{sharingSources}}" wx:key="source_key" class="review-source"><view>{{item.nickname}} · 第 {{item.sequence}} 套 · {{item.usageLabel || (item.usage === 'backup' ? '备用' : '主搭配')}}</view><view>{{item.target_date}} · {{item.selected_by || '家人'}}已选 · {{item.periodLabel || '按日安排'}}</view></view><view wx:for="{{periods}}" wx:key="child_id" class="review-period-row"><view>{{item.nickname}}</view><picker range="{{periodOptions}}" value="{{item.periodIndex}}" data-id="{{item.child_id}}" bindchange="choosePeriod" disabled="{{!writable || busy}}"><view class="c-dropdown">{{item.start ? item.periodLabel : '请选择时段'}}</view></picker></view><view class="review-field-label">为什么能这样分时安排</view><textarea class="review-reason" placeholder="说明宝贝分别在什么时间使用这件衣物" value="{{sharingReason}}" bindinput="sharingReason" maxlength="300" disabled="{{!writable || busy}}" auto-height/><view wx:if="{{sharingValidation}}" class="review-validation">{{sharingValidation}}</view><view wx:if="{{sharingDirty}}" class="c-note c-warning">有未确认的填写。确认后才更新草稿；取消会恢复此前有效的安排。</view><view class="review-basis">其他已选来源或使用方式变化后，请重新核对全部安排。分时不改变衣物的可穿与合身情况。</view></scroll-view><view class="c-actions"><button bindtap="cancelSharing">取消填写</button><button class="primary" bindtap="confirmSharing" disabled="{{!writable || busy || !sharingReady}}">确认分时安排</button></view></view></view>
  <view wx:if="{{compareOpen}}" class="c-mask" bindtap="closeCompare" catchtouchmove="noop"><view class="c-sheet review-sheet review-compare-sheet" catchtap="noop" aria-role="dialog" aria-label="家人最新方案"><view class="review-sheet-heading"><view class="review-section-title">看最新对比</view><button class="review-close" bindtap="closeCompare" aria-label="关闭最新对比">×</button></view><scroll-view scroll-y class="review-sheet-scroll"><view class="review-section-title">你保留的未保存调整</view><template is="review-pieces" data="{{items:reviewSnapshot.main_items,view:'reviewSnapshot'}}"/><view class="review-basis">{{reviewSnapshot.backupLabel}}</view><template wx:if="{{reviewSnapshot.backup.items.length}}" is="review-pieces" data="{{items:reviewSnapshot.backup.items,view:'reviewSnapshot'}}"/><view class="review-section"><view class="review-section-title">家人当前已选</view><block wx:if="{{latestView}}"><view class="review-basis">第 {{latestView.sequence}} 套 · {{latestView.selected_by || '家人'}}已选</view><template is="review-pieces" data="{{items:latestView.main_items,view:'latestView'}}"/><view class="review-basis">{{latestView.backupLabel}}</view><template wx:if="{{latestView.backup.items.length}}" is="review-pieces" data="{{items:latestView.backup.items,view:'latestView'}}"/></block><view wx:else class="c-note c-warning">这套目前无法查看。当前草稿仍保留，请返回核对。</view></view><view class="review-basis">选择重新编辑时，会先确认是否放弃你的未保存调整。</view></scroll-view><button bindtap="useLatest" disabled="{{!writable || busy || !latestPlan}}">以最新重新编辑</button><button bindtap="asNew" disabled="{{!writable || busy}}">当前草稿改为新增</button><button class="primary" bindtap="closeCompare">继续保留草稿</button></view></view>
  <view wx:if="{{garmentReviewOpen}}" class="c-mask" bindtap="cancelGarments" catchtouchmove="noop"><view class="c-sheet review-sheet" catchtap="noop" aria-role="dialog" aria-label="核对衣物最新资料"><view class="review-sheet-heading"><view class="review-section-title">核对衣物最新资料</view><button class="review-close" bindtap="cancelGarments" aria-label="关闭衣物资料核对">×</button></view><view class="review-basis">确认后才更新这份草稿，原已选记录仍保留。</view><scroll-view scroll-y class="review-sheet-scroll"><view wx:for="{{latestGarmentRows}}" wx:key="id" class="review-garment-row"><view class="review-section-title">{{item.usage === 'backup' ? '备用' : '主搭配'}} · {{item.name}}</view><view class="review-basis">原资料：{{item.previous.name}}</view><view wx:if="{{item.current}}">最新资料：{{item.current.name}}</view><view class="{{item.available ? 'review-basis' : 'review-item-warning'}}">{{item.message}}</view></view></scroll-view><view class="review-basis">确认后重新核对整套、天气和共用安排。</view><view class="c-actions"><button bindtap="cancelGarments">保留原草稿</button><button class="primary" bindtap="confirmGarments" disabled="{{!writable || busy}}">确认资料并核对</button></view></view></view>
</view>
