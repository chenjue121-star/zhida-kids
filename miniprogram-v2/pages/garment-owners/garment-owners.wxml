<view class="b-page b-owners-page">
 <view wx:if="{{loading}}" class="loading">正在读取衣物和使用关系…</view>
 <view wx:if="{{error}}" class="notice error">{{error}}<button wx:if="{{accessRevoked}}" bindtap="goFamilies">选择其他家庭</button></view>
 <block wx:if="{{ready && writable}}">
  <view wx:if="{{pendingRestore}}" class="b-note">上次恢复结果尚待核实。<button bindtap="queryRestore" disabled="{{busy}}">查询原恢复操作</button><button bindtap="resolveRestore" disabled="{{busy}}">核实未执行</button></view>
  <view class="b-item-context"><image wx:if="{{image}}" src="{{image}}" mode="aspectFit" bindtap="preview"/><view wx:else class="b-context-placeholder">{{garment.asset_id ? '原图' : '手填'}}</view><view class="b-context-copy"><view class="b-context-name">{{garment.name}}</view><view class="b-context-meta">同一件实物 · {{garment.stateLabel}}</view></view><button wx:if="{{garment.asset_id}}" class="link" bindtap="preview">原图 ↗</button></view>
  <view wx:if="{{imageError}}" class="b-muted">{{imageError}}<button class="link" bindtap="preview">重试查看原图</button></view>
  <block wx:if="{{alreadyRestored}}"><view class="b-note">家人已恢复这件实物。当前状态为{{garment.stateLabel}}，保留当前记录，你这次未保存的选择不会覆盖它。</view><view class="b-section-title">当前使用者与合身</view><view wx:for="{{garment.owners}}" wx:key="child_id" class="b-history-row"><text>{{item.nickname}}</text><text>{{item.fitLabel}}</text></view><view class="b-fixed"><button class="primary" bindtap="viewCurrent">查看当前衣物</button></view></block>
  <block wx:else>
   <block wx:if="{{mode === 'restore'}}"><view class="b-info-row"><text>实物状态保留</text><text>{{garment.stateLabel}}</text></view><view class="b-section-title">上次使用记录</view><view class="b-history-list"><view wx:for="{{historyOwners}}" wx:key="child_id" class="b-history-row"><text>{{item.nickname}}{{item.archived ? '（已归档）' : ''}}</text><text>{{item.fitLabel}}</text></view></view><view class="b-note">请按现在的情况分别核对。只选择同家庭、未归档的宝贝，恢复衣物不会恢复宝贝档案。</view></block>
   <view wx:elif="{{mode === 'sharing'}}" class="b-note">共用同一件实物，每位宝贝的合身分别设置。取消一位只停止给他使用，其他宝贝保留，至少保留一位使用者。</view>
   <block wx:if="{{mode === 'transfer'}}"><view class="b-transfer-path"><view class="b-transfer-person"><view class="b-initial">{{previousOwner.nickname[0]}}</view><view>{{previousOwner.nickname}}</view><text>转交后不再使用</text></view><view class="b-transfer-arrow">→</view><view class="b-transfer-person"><view class="b-initial">{{targetOwner ? targetOwner.initial : '？'}}</view><view>{{targetOwner ? targetOwner.nickname : '选择新使用者'}}</view><text>转交后开始使用</text></view></view><view class="b-note">原图和资料保留，{{garment.stateLabel}}状态不变。两个宝贝都还要使用时，请改为共用。</view></block>
   <view wx:if="{{mode === 'transfer' ? !transferChoices.length : !choices.length}}" class="b-empty"><view class="b-empty-title">{{mode === 'transfer' ? '暂无其他宝贝可转交' : '暂无有效宝贝'}}</view><view class="b-empty-copy">先添加宝贝，再核对使用关系。不会恢复已归档孩子。</view><button class="primary" bindtap="addChild">添加宝贝</button></view>
   <block wx:if="{{mode !== 'transfer'}}"><view class="b-section-title">{{mode === 'restore' ? '恢复后给哪些宝贝使用？' : '给哪些宝贝使用？'}}</view><checkbox-group bindchange="choose"><view wx:for="{{choices}}" wx:key="id" class="b-owner-row"><label class="b-check {{item.selected ? 'selected' : ''}}"><checkbox value="{{item.id}}" checked="{{item.selected}}"/><view class="b-circle"></view><view class="b-initial">{{item.initial}}</view><view class="b-owner-copy"><view>{{item.nickname}}</view><view class="b-owner-age">{{item.ageLabel}}</view><view wx:if="{{mode === 'sharing' && item.isNew && item.selected}}" class="b-owner-age b-new-owner">新增使用者</view></view></label><picker disabled="{{!item.selected}}" range="{{fitOptions}}" range-key="label" value="{{item.fitIndex}}" data-id="{{item.id}}" bindchange="fit"><view class="b-select {{item.selected && !item.fit ? 'b-fit-required' : ''}}">{{item.fitIndex >= 0 ? fitOptions[item.fitIndex].label : '请选择'}}</view></picker></view></checkbox-group></block>
   <block wx:elif="{{transferChoices.length}}"><view class="b-info-row"><text>转交给</text><picker range="{{transferChoices}}" range-key="nickname" value="{{targetIndex}}" bindchange="target"><view class="b-select">{{targetOwner ? targetOwner.nickname : '请选择'}}</view></picker></view><view wx:if="{{targetOwner}}" class="b-info-row"><text>对{{targetOwner.nickname}}是否合身</text><picker range="{{fitOptions}}" range-key="label" value="{{targetOwner.fitIndex}}" data-id="{{targetOwner.id}}" bindchange="fit"><view class="b-select {{!targetOwner.fit ? 'b-fit-required' : ''}}">{{targetOwner.fitIndex >= 0 ? fitOptions[targetOwner.fitIndex].label : '请选择'}}</view></picker></view><view wx:if="{{targetOwner}}" class="b-note"><view>确认后会发生什么</view><view>{{previousOwner.nickname}}衣橱不再展示这件衣物。</view><view>{{targetOwner.nickname}}衣橱显示这件衣物。</view><view>同一件实物，{{garment.stateLabel}}状态保留。</view></view></block>
   <view wx:if="{{mode === 'sharing'}}" class="b-note">{{garment.stateLabel}}状态随同一件衣物保留。以后改一次实物状态，所有使用者都会看到更新。</view>
   <view wx:if="{{latest}}" class="b-conflict"><view>家人修改后的最新使用关系：</view><view wx:for="{{latest.owners}}" wx:key="child_id">{{item.nickname}}：{{item.fitLabel}}</view><view>你的原填写：</view><view wx:for="{{oldDraft}}" wx:key="id" wx:if="{{item.selected}}">{{item.nickname}}：{{item.fitLabel || item.fit}}</view><button bindtap="adoptLatest">重新核对当前使用关系</button></view>
   <view class="b-fixed b-owner-footer"><view class="b-footer-note">{{mode === 'restore' ? '请分别确认当前合身，原图、资料和历史继续保留' : mode === 'transfer' ? '新宝贝合身单独核对，实物状态保留' : '新增使用者需明确合身，拿不准可选暂不清楚'}}</view><view class="b-footer-actions"><button class="b-secondary" bindtap="back">取消</button><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || !canSave || conflict}}">{{mode === 'restore' ? '核对后恢复衣物' : mode === 'transfer' ? '确认转交' : '保存归属'}}</button></view></view>
  </block>
 </block>
</view>
