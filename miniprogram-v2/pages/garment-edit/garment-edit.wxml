<view class="b-page"><view wx:if="{{error}}" class="notice error">{{error}}<button wx:if="{{accessRevoked}}" bindtap="goFamilies">选择其他家庭</button></view><view wx:if="{{loading}}" class="loading">正在读取资料…</view>
 <block wx:if="{{ready && writable}}"><view wx:if="{{garment.asset_id || garment.local_path}}" class="b-origin"><image wx:if="{{image}}" class="b-origin-image" src="{{image}}" mode="aspectFit" bindtap="preview"/><view class="b-origin-copy"><view class="b-result-title">{{form.name || '核对这件单品'}}</view><view class="b-source">来自 {{sourceLabel}}</view><view wx:if="{{imageError}}" class="b-muted">{{imageError}}</view><button class="link" bindtap="preview">查看完整原图</button></view></view><view wx:if="{{candidateMode}}" class="b-note">保存只更新待确认草稿。颜色、图案和厚薄可以暂不清楚，类别需核对。</view><view class="field"><text class="field-label">名称</text><input value="{{form.name}}" maxlength="80" data-field="name" bindinput="input" placeholder="可使用类别作为名称"/></view>
 <view class="b-edit-field"><text>类别 *</text><picker range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" data-field="category" bindchange="option"><view class="b-select">{{categoryIndex >= 0 ? categoryOptions[categoryIndex].label : '请选择类别'}}</view></picker></view>
 <view class="b-edit-field"><text>颜色</text><button class="b-select b-color-summary" bindtap="openColors" disabled="{{busy}}">{{colorSummary}}</button></view>
 <view class="b-edit-field"><text>图案</text><picker range="{{patternOptions}}" range-key="label" value="{{patternIndex}}" data-field="pattern" bindchange="option"><view class="b-select">{{patternOptions[patternIndex].label}}</view></picker></view>
 <view class="b-edit-field"><text>厚薄 · 可选</text><picker range="{{thicknessOptions}}" range-key="label" value="{{thicknessIndex}}" data-field="thickness" bindchange="option"><view class="b-select">{{thicknessOptions[thicknessIndex].label}}</view></picker></view>
 <view class="b-edit-field"><view><view>实物状态</view><view class="b-muted">所有使用者同步</view></view><picker range="{{stateOptions}}" range-key="label" value="{{stateIndex}}" data-field="state" bindchange="option"><view class="b-select">{{stateOptions[stateIndex].label}}</view></picker></view>
 <view wx:if="{{candidateMode && garment.owners.length === 1}}" class="b-edit-field"><text>对{{fitChildLabel}}是否合身</text><picker range="{{fitOptions}}" range-key="label" value="{{fitIndex}}" data-field="fit" bindchange="option"><view class="b-select">{{fitOptions[fitIndex].label}}</view></picker></view><button wx:if="{{!newCandidate}}" class="link" bindtap="owners">逐位调整归属与合身 ›</button>
 <view wx:if="{{latest}}" class="b-conflict"><view>家人已修改，当前最新内容：</view><view>{{latest.name}} · {{latest.stateLabel}} · {{latest.ownerLabel}}</view><view wx:for="{{latest.owners}}" wx:key="child_id">{{item.nickname}}：{{item.fitLabel}}</view><view>你的填写已保留。请逐项对照后继续。</view><button bindtap="adoptLatest">已核对，以当前版本继续编辑</button></view>
 <view class="b-fixed"><button bindtap="back">取消</button><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy || conflict || categoryIndex < 0}}">{{candidateMode ? '保存候选草稿' : '保存资料'}}</button></view></block>
 <view wx:if="{{colorSheet && writable}}" class="b-mask" bindtap="cancelColors"><view class="b-sheet" catchtap="noop"><view class="b-sheet-heading"><view class="b-sheet-title">选择颜色</view><button class="b-close" bindtap="cancelColors" aria-label="取消颜色选择">×</button></view><view class="b-muted">可以多选，拿不准就保留暂不清楚。完成只更新当前填写，点击本页保存后生效。</view><checkbox-group bindchange="colors"><view class="b-color-grid"><label wx:for="{{colorDraftOptions}}" wx:key="key" class="b-check {{item.checked ? 'selected' : ''}}"><checkbox value="{{item.key}}" checked="{{item.checked}}"/><view class="b-circle"></view><text>{{item.label}}</text></label></view></checkbox-group><view class="actions"><button bindtap="cancelColors">取消</button><button class="primary" bindtap="completeColors">完成选择</button></view></view></view>
</view>
