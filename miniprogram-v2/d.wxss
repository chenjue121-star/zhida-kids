.d-page {padding-bottom:calc(104px + env(safe-area-inset-bottom))}.d-heading {padding:8px 0 4px}.d-heading .meta {margin-top:8px}.d-honesty {margin:25px 0;color:#60758a;font-size:12px;line-height:1.7}.d-empty {padding:28px 0}.d-empty .meta {margin-top:8px}.d-photos {display:flex;gap:10px;margin-top:12px}.d-photos image {width:68px;height:68px;background:#f6f8f7;border-radius:8px}.d-section {margin-top:24px;padding-top:20px;border-top:1px solid #e5eaf0}.d-section-title {font-size:17px;font-weight:700;margin-bottom:12px}.d-garment {display:flex;align-items:center;gap:13px;padding:13px 0;border-bottom:1px solid #eff2f4}.d-garment image,.d-garment-placeholder {width:72px;height:72px;flex:none;border-radius:8px;background:#f6f8f7}.d-garment-placeholder {display:flex;justify-content:center;align-items:center;font-size:12px;color:#60758a}.d-garment .grow {flex:1;min-width:0}.d-sheet-mask {position:fixed;inset:0;background:rgba(15,33,24,.35);z-index:80;display:flex;align-items:flex-end}.d-sheet {width:100%;max-height:87vh;overflow-y:auto;background:#fff;border-radius:18px 18px 0 0;padding:22px 20px calc(25px + env(safe-area-inset-bottom))}.d-sheet-heading {display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}.d-sheet-heading button {min-width:44px;min-height:44px;padding:8px;background:#f2f5f3;font-size:20px}.d-sheet .choice {font-size:14px}.d-sheet .actions {margin-top:18px}.d-source {color:#596d82;font-size:13px;margin-bottom:16px}.d-warning {font-size:13px;color:#775720;background:#fcf6e9;padding:12px;border-radius:8px;margin:10px 0}.d-error {color:#9b2929}.d-evidence {font-size:13px;border-top:1px solid #e5eaf0;padding:12px 0}.d-evidence .meta {margin-top:5px}.d-current {padding:14px;background:#f4f8f5;border-radius:9px}.d-current .name {font-size:15px}.d-actions {display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}.d-actions button {min-height:47px}.d-reuse-source {margin-top:14px;font-size:13px;color:#60758a}.d-sheet .sectio