# =====================================================
# 智搭（儿童）- 后端配置示例
# 使用方法：复制本文件为 .env 并填入真实值
# .env 文件不要提交到 git 仓库（已在 .gitignore 排除）
# =====================================================

# 数据库连接
DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/zhida_kids?charset=utf8mb4

# JWT 会话密钥（启动时首次填入即可，改了会让所有登录态失效）
JWT_SECRET=本地调试随意填任意字符串_生产环境请换长随机串

# 微信小程序
WECHAT_APPID=微信公众平台申请的小程序AppID
WECHAT_SECRET=微信公众平台申请的小程序密钥
DEV_WECHAT_MOCK=false

# 调试模式
DEBUG=true

# 图片上传方式：local（本地）或 cos（腾讯云COS）
UPLOAD_BACKEND=local
UPLOAD_DIR=uploads

# 腾讯云 COS（当 UPLOAD_BACKEND=cos 时需要）
TENCENT_COS_SECRET_ID=详见腾讯云CAM控制台创建子账号密钥
TENCENT_COS_SECRET_KEY=详见腾讯云CAM控制台创建子账号密钥
TENCENT_COS_REGION=ap-shanghai
TENCENT_COS_BUCKET=你的存储桶名称-125xxxxxx
TENCENT_COS_PREFIX=zhida-kids/dev
TENCENT_COS_PUBLIC_BASE_URL=https://你的存储桶名称.cos.ap-shanghai.myqcloud.com

# 阿里云视觉智能开放平台（服饰抠图 + 服饰属性识别）
# 开通地址：https://www.aliyun.com/product/ai/viapi
ALIYUN_ACCESS_KEY_ID=详见阿里云RAM控制台创建AccessKey
ALIYUN_ACCESS_KEY_SECRET=详见阿里云RAM控制台创建AccessKey
ALIYUN_VIAPI_REGION=cn-shanghai

# PUBLIC_BASE_URL：当 UPLOAD_BACKEND=local 时，
# 需要让这个地址能被小程序/客户端访问到本地 uploads 目录；
# 若使用 ngrok 等内网穿透，填 https 地址即可
PUBLIC_BASE_URL=http://127.0.0.1:8000

# AI 图片 fallback（启用后会用 base64 替代公网 URL，仅用于调试）
AI_IMAGE_DATA_URL_FALLBACK=false

# 和风天气（实时天气/位置查询）
QWEATHER_API_KEY=在https://dev.qweather.com申请

# 字节火山方舟（ark）模型推理
ARK_API_KEY=在https://www.volcengine.com/product/ark申请
ARK_RESPONSES_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_CLOTHING_MODEL=doubao-seed-2-0-mini-260215

# 其它可选 AI（预留）
GPTSAPI_API_KEY=第三方AI平台的key
GPTSAPI_BASE_URL=https://api.gptsapi.net/v1/messages
GPTSAPI_MODEL=claude-sonnet-4-6
GPTSAPI_IMAGE_EDIT_URL=https://api.gptsapi.net/api/v3/openai/gpt-image-2-plus/image-edit
GPTSAPI_IMAGE_OUTPUT_FORMAT=png
GPTSAPI_IMAGE_POLL_INTERVAL=2
GPTSAPI_IMAGE_POLL_MAX_ATTEMPTS=30

# 开发模式开关：true 时直接走 mock 数据，不请求外部 AI
DEV_AI_MOCK=false
DEV_OUTFIT_MOCK=false

# 风格规则集路径与ID
STYLE_RULESET_PATH=app/style_profiles/kids_outfit_cn_v1.yaml
STYLE_RULESET_ID=kids_outfit_cn_v1
