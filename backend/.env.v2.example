# Isolated v2 database. Never point this at the existing zhida_kids database.
V2_DATABASE_URL=mysql+pymysql://zhida_v2_local:LOCAL_PASSWORD@127.0.0.1:3306/zhida_kids_v2_dev?charset=utf8mb4
V2_TEST_DATABASE_URL=mysql+pymysql://zhida_v2_local:LOCAL_PASSWORD@127.0.0.1:3306/zhida_kids_v2_test?charset=utf8mb4
V2_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
V2_ENV=development
V2_DEV_WECHAT_MOCK=false
V2_WECHAT_APPID=wx33ab8a66217dc933
V2_WECHAT_SECRET=
# From QWeather Console > Project Settings. Both values are needed for real weather.
V2_QWEATHER_API_HOST=
V2_QWEATHER_API_KEY=
# Private files are served only through authenticated /v2/.../assets/{id}/content.
# Use an absolute, persistent directory shared by API and worker; no public static mount.
V2_PRIVATE_STORAGE_DIR=/absolute/path/to/zhida-v2-private-media
V2_UPLOAD_MAX_BYTES=12582912
# The API only queues durable work. Start a separate worker process to recognize photos.
# Empty API keys produce an honest failed/manual result without calling a provider.
# Selected recognition baseline: Seed 2.1 Lite with the original recognition prompt.
# Enable this exact model in the Ark console and configure its regional API key.
V2_RECOGNITION_PROVIDER=ark
V2_RECOGNITION_MODEL=doubao-seed-2-1-lite-260915
V2_ARK_API_KEY=
V2_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional Qwen: set provider=qwen AND model=qwen3.8-flash explicitly, then add a key.
# A Qwen key alone does not override the selected Ark provider.
V2_QWEN_API_KEY=
V2_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
V2_RECOGNITION_MAX_ATTEMPTS=3
V2_RECOGNITION_LEASE_SECONDS=120
# Daily outfits use the same configured Qwen/Ark keys, without children's photos or names.
# Keep disabled until provider use is explicitly enabled; server rules remain available.
V2_OUTFIT_PROVIDER=disabled
V2_OUTFIT_MODEL=qwen3.7-plus-2026-05-26
V2_OUTFIT_TIMEOUT_SECONDS=15
