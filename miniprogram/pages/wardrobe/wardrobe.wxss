/* =============================================
   我的衣橱 · 温暖奶油色系
   ============================================= */

.wardrobe-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5E4 0%, #FFFBF4 40%, #FFFFFF 100%);
  padding: 48rpx 32rpx 160rpx;
  box-sizing: border-box;
}

/* ========== 页面标题 ========== */

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #2A2A28;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.page-subtitle {
  font-size: 26rpx;
  color: #6F6B60;
  font-weight: 500;
}

.header-emoji {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(107, 166, 92, 0.18);
}

/* ========== 宝贝切换器 ========== */

.child-section {
  margin-bottom: 28rpx;
}

.child-switcher {
  white-space: nowrap;
  padding: 4rpx 0;
}

.child-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx 12rpx 12rpx;
  margin-right: 14rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  border: 2rpx solid #EFE5D3;
  box-shadow: 0 4rpx 12rpx rgba(173, 156, 108, 0.06);
  transition: all 0.25s ease;
}

.child-tab.active {
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  box-shadow: 0 6rpx 16rpx rgba(107, 166, 92, 0.22);
}

.child-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 12rpx;
  background: linear-gradient(135deg, #FFE4B5 0%, #FFD89A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.child-meta {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.child-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A28;
  line-height: 1.2;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.child-tab.active .child-name {
  color: #6BA65C;
}

.child-age {
  font-size: 20rpx;
  color: #6F6B60;
  margin-top: 2rpx;
}

.child-add-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  padding: 8rpx 0;
  background: #FFFFFF;
  border: 2rpx dashed #EFE5D3;
  border-radius: 24rpx;
  margin-right: 16rpx;
}

.add-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #EEF5E5;
  color: #6BA65C;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
  margin-bottom: 4rpx;
}

.add-name {
  font-size: 20rpx;
  color: #6F6B60;
}

/* ========== 统计卡片 ========== */

.stats-card {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFBF4 100%);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(173, 156, 108, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2A2A28;
  letter-spacing: 1rpx;
}

.stats-total {
  font-size: 24rpx;
  color: #6F6B60;
  font-weight: 500;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stats-cell {
  min-height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #EEF5E5 0%, #E4EFDA 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.stats-cell.cell-warm {
  background: linear-gradient(145deg, #FFF0D6 0%, #FFE5B8 100%);
}

.stats-cell.cell-gray {
  background: linear-gradient(145deg, #F2F0EC 0%, #E8E5E0 100%);
}

.stats-cell.cell-accent {
  background: linear-gradient(145deg, #FFE9D4 0%, #FFD4B0 100%);
}

.stats-number {
  font-size: 38rpx;
  font-weight: 900;
  color: #6BA65C;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.cell-warm .stats-number {
  color: #B8791F;
}

.cell-gray .stats-number {
  color: #6B6B6B;
}

.cell-accent .stats-number {
  color: #D47A3D;
}

.stats-label {
  font-size: 22rpx;
  color: #6F6B60;
  font-weight: 500;
  margin-top: 4rpx;
}

/* 类型占比条形图 */

.type-chart {
  margin-top: 8rpx;
  padding: 24rpx 8rpx 8rpx;
  border-top: 2rpx dashed #EFE5D3;
}

.chart-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A28;
  margin-bottom: 20rpx;
}

.chart-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chart-row {
  display: flex;
  align-items: center;
}

.chart-name {
  width: 140rpx;
  font-size: 24rpx;
  color: #6F6B60;
  font-weight: 500;
  flex-shrink: 0;
}

.chart-bar-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.chart-bar {
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #F5EEDD 0%, #EDE4CF 100%);
  margin-right: 16rpx;
  min-width: 60rpx;
}

.chart-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #7DB96E 0%, #5BA557 100%);
  box-shadow: 0 2rpx 6rpx rgba(107, 166, 92, 0.3);
}

.chart-percent {
  font-size: 24rpx;
  color: #6F6B60;
  font-weight: 600;
  width: 64rpx;
  text-align: right;
  flex-shrink: 0;
}

/* 小贴士 */

.stats-tips {
  margin-top: 20rpx;
  padding: 20rpx 8rpx 8rpx;
  border-top: 2rpx dashed #EFE5D3;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #6F6B60;
  line-height: 1.6;
}

/* ========== 筛选标签栏 ========== */

.filter-section {
  margin-bottom: 24rpx;
}

.filter-bar {
  white-space: nowrap;
  padding: 4rpx 0;
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE5D3;
  box-shadow: 0 4rpx 12rpx rgba(173, 156, 108, 0.06);
  transition: all 0.25s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  box-shadow: 0 4rpx 12rpx rgba(107, 166, 92, 0.18);
}

.tab-emoji {
  font-size: 26rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.tab-text {
  font-size: 26rpx;
  color: #6F6B60;
  font-weight: 500;
}

.filter-tab.active .tab-text {
  color: #6BA65C;
  font-weight: 700;
}

/* ========== 衣物网格 ========== */

.clothing-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx;
}

.clothing-card {
  width: calc(50% - 10rpx);
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFBF4 100%);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(173, 156, 108, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  transition: transform 0.2s ease;
}

.clothing-card:active {
  transform: scale(0.97);
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
  display: block;
}

.card-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #F5EEDD 0%, #EFE2C5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-emoji {
  font-size: 120rpx;
  line-height: 1;
  opacity: 0.7;
}

/* 状态角标 */

.status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(10rpx);
}

.status-badge.stored {
  background: linear-gradient(135deg, #FFE5B8 0%, #FFD89A 100%);
}

.status-badge.retired {
  background: linear-gradient(135deg, #E8E5E0 0%, #D6D1C9 100%);
}

.badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #7A4E00;
}

.status-badge.retired .badge-text {
  color: #5A5A5A;
}

/* 卡片信息区 */

.card-info {
  padding: 20rpx 20rpx 24rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2A2A28;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.card-season {
  display: inline-block;
  padding: 6rpx 14rpx;
  background: #EEF5E5;
  border-radius: 16rpx;
}

.season-text {
  font-size: 22rpx;
  color: #6BA65C;
  font-weight: 600;
}

/* ========== 空状态 ========== */

.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFBF4 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(173, 156, 108, 0.08);
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 10rpx rgba(255, 255, 255, 0.8);
}

.empty-icon-box.icon-warm {
  background: linear-gradient(145deg, #FFE4B5 0%, #FFD89A 100%);
}

.empty-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.empty-state .empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #2A2A28;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.empty-state .empty-desc {
  display: block;
  font-size: 26rpx;
  color: #6F6B60;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

.empty-btn {
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

/* ========== FAB 浮动按钮 ========== */

.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7DB96E 0%, #5BA557 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(107, 166, 92, 0.38),
              0 4rpx 8rpx rgba(107, 166, 92, 0.2);
  z-index: 50;
  transition: transform 0.2s ease;
}

.fab-button:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 60rpx;
  color: #FFFFFF;
  line-height: 1;
  font-weight: 300;
  margin-top: -4rpx;
}

