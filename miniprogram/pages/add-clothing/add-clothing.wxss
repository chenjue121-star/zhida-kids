/* ================================================
   添加衣物 · 温暖奶油风
   ================================================ */

.add-clothing-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5E4 0%, #FFFBF4 50%, #FFFFFF 100%);
  padding: 32rpx 28rpx 200rpx;
  box-sizing: border-box;
}

/* ========== 页面标题 ========== */

.page-header {
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx 32rpx;
}

.header-icon-box {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(107, 166, 92, 0.18);
}

.header-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2A2A28;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.page-subtitle {
  font-size: 24rpx;
  color: #6F6B60;
  margin-top: 6rpx;
}

/* ========== 卡片基础 ========== */

.photo-card,
.ai-card,
.form-card {
  background: linear-gradient(160deg, #FFFFFF 0%, #FFFBF4 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(173, 156, 108, 0.08),
              inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2A2A28;
  letter-spacing: 1rpx;
}

.card-sub {
  font-size: 22rpx;
  color: #B5B0A4;
  margin-left: 12rpx;
  background: #F7F1E4;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-weight: 500;
}

/* ========== 照片区 ========== */

.photo-preview-wrap {
  position: relative;
  width: 100%;
  height: 440rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #F7F1E4 0%, #EFE5D3 100%);
}

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-retake {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 100rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.retake-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.retake-text {
  font-size: 26rpx;
  color: #2A2A28;
  font-weight: 600;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx 8rpx;
}

.placeholder-icon-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: 44rpx;
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: inset 0 4rpx 10rpx rgba(255, 255, 255, 0.9);
}

.placeholder-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.placeholder-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2A2A28;
  margin-bottom: 8rpx;
}

.placeholder-desc {
  font-size: 24rpx;
  color: #6F6B60;
  margin-bottom: 28rpx;
}

.photo-btn-row {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-top: 12rpx;
}

.photo-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 28rpx;
}

.photo-btn-primary {
  background: linear-gradient(135deg, #7DB96E 0%, #6BA65C 100%);
}

.photo-btn-emoji {
  font-size: 30rpx;
  margin-right: 8rpx;
}

.photo-btn-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* ========== AI 识别状态卡片 ========== */

.ai-card {
  background: linear-gradient(150deg, #FFFBEB 0%, #FFFFFF 60%);
  border: 2rpx solid rgba(242, 184, 75, 0.25);
  box-shadow: 0 8rpx 24rpx rgba(242, 184, 75, 0.12);
}

.ai-state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
}

.ai-spinner-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFE4B5 0%, #FFD89A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  animation: ai-spin 2s ease-in-out infinite;
  box-shadow: 0 6rpx 20rpx rgba(242, 184, 75, 0.28);
}

.ai-spinner-emoji {
  font-size: 56rpx;
  line-height: 1;
}

@keyframes ai-spin {
  0%, 100% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.08) rotate(8deg); }
}

.ai-state-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2A2A28;
  margin-bottom: 6rpx;
}

.ai-state-desc {
  font-size: 24rpx;
  color: #6F6B60;
}

.ai-result-box {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 8rpx;
}

.ai-result-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.ai-result-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ai-result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F2B84B;
  margin-bottom: 6rpx;
}

.ai-result-desc {
  font-size: 26rpx;
  color: #2A2A28;
  line-height: 1.5;
}

/* ========== 宝贝选择 ========== */

.child-scroll {
  white-space: nowrap;
  padding: 4rpx 0;
}

.child-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx 10rpx 10rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE5D3;
  border-radius: 100rpx;
  transition: all 0.25s ease;
}

.child-pill.active {
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  box-shadow: 0 4rpx 12rpx rgba(107, 166, 92, 0.18);
}

.child-pill-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFE4B5 0%, #FFD89A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.pill-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.child-pill-name {
  font-size: 26rpx;
  color: #2A2A28;
  font-weight: 600;
}

.child-pill.active .child-pill-name {
  color: #6BA65C;
}

/* ========== 衣物类型网格 ========== */

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #EFE5D3;
  transition: all 0.25s ease;
}

.type-item.active {
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  box-shadow: 0 4rpx 14rpx rgba(107, 166, 92, 0.18);
}

.type-emoji {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.type-label {
  font-size: 24rpx;
  color: #2A2A28;
  font-weight: 600;
  text-align: center;
}

.type-item.active .type-label {
  color: #6BA65C;
}

.sub-type-wrap {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #EFE5D3;
}

.mini-label {
  font-size: 24rpx;
  color: #6F6B60;
  margin-bottom: 16rpx;
  font-weight: 600;
  display: block;
}

/* ========== chip 胶囊 ========== */

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip-pill {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE5D3;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: #2A2A28;
  transition: all 0.22s ease;
}

.chip-pill.active {
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  color: #6BA65C;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(107, 166, 92, 0.18);
}

.chip-with-emoji {
  padding: 12rpx 24rpx 12rpx 14rpx;
}

.chip-emoji {
  font-size: 26rpx;
  margin-right: 8rpx;
  line-height: 1;
}

/* ========== 颜色搜索 & 分组 ========== */

.color-search {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #F7F1E4;
  border-radius: 100rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.search-emoji {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #2A2A28;
  background: transparent;
}

.search-placeholder {
  color: #B5B0A4;
  font-size: 26rpx;
}

.group-scroll {
  white-space: nowrap;
  padding: 4rpx 0 20rpx;
  margin-bottom: 8rpx;
}

.group-pill {
  display: inline-flex;
  padding: 12rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE5D3;
  border-radius: 100rpx;
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #2A2A28;
  transition: all 0.22s ease;
}

.group-pill.active {
  background: linear-gradient(135deg, #FFF4DC 0%, #FDE9B6 100%);
  border-color: #F2B84B;
  color: #B8791F;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(242, 184, 75, 0.22);
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #EFE5D3;
  transition: all 0.25s ease;
}

.color-item.active {
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  box-shadow: 0 4rpx 14rpx rgba(107, 166, 92, 0.18);
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 10rpx;
}

.color-item.active .color-dot {
  border-color: #6BA65C;
  box-shadow: 0 0 0 4rpx rgba(107, 166, 92, 0.18);
}

.color-name {
  font-size: 22rpx;
  color: #2A2A28;
  font-weight: 500;
  text-align: center;
}

.color-item.active .color-name {
  color: #6BA65C;
  font-weight: 700;
}

/* ========== 品牌 & 尺码输入 ========== */

.input-row {
  display: flex;
  gap: 16rpx;
}

.input-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 18rpx 24rpx;
  background: #F7F1E4;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.input-label {
  font-size: 22rpx;
  color: #6F6B60;
  margin-bottom: 6rpx;
  font-weight: 600;
}

.form-input {
  font-size: 28rpx;
  color: #2A2A28;
  background: transparent;
}

.input-placeholder {
  color: #B5B0A4;
  font-size: 26rpx;
}

/* ========== 底部占位 & 固定按钮 ========== */

.bottom-spacer {
  height: 80rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 251, 244, 0) 0%, rgba(255, 251, 244, 0.95) 30%, #FFFBF4 100%);
  box-shadow: 0 -8rpx 24rpx rgba(173, 156, 108, 0.08);
  z-index: 10;
}

.save-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 0;
  background: linear-gradient(135deg, #7DB96E 0%, #6BA65C 100%);
  box-shadow: 0 8rpx 24rpx rgba(107, 166, 92, 0.3);
}

.save-btn[disabled] {
  background: linear-gradient(135deg, #C4D4B8 0%, #A8BE98 100%);
  box-shadow: none;
  color: rgba(255, 255, 255, 0.9);
}

.save-text {
  letter-spacing: 2rpx;
}

