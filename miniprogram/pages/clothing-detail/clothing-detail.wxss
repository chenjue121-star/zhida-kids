/* ================================================
   衣物详情页 · 温暖奶油风
   主色：草木绿 #6BA65C | 强调色：阳光金 #F2B84B
   ================================================ */

.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5E4 0%, #FFFBF4 40%, #FFFFFF 100%);
  padding-bottom: 60rpx;
}

/* ========== 顶部大图区 ========== */

.photo-section {
  width: 100%;
  padding: 24rpx 32rpx 0;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #F8F0E5 0%, #F5E6D3 100%);
  box-shadow: 0 16rpx 40rpx rgba(173, 156, 108, 0.18),
              inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.detail-photo {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 40%, #FFFBF4 0%, #F5E6D3 100%);
}

.placeholder-icon {
  font-size: 180rpx;
  line-height: 1;
}

.photo-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(173, 156, 108, 0.15);
}

.photo-tag-text {
  font-size: 24rpx;
  color: #6F6B60;
  font-weight: 600;
}

/* ========== 主体信息卡片 ========== */

.info-card {
  margin: 28rpx 32rpx 24rpx;
  padding: 32rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #FFFBF4 100%);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 32rpx rgba(173, 156, 108, 0.12),
              inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.info-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.info-title-box {
  flex: 1;
  min-width: 0;
}

.info-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2A2A28;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
  line-height: 1.3;
}

.info-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.info-meta {
  font-size: 26rpx;
  color: #6F6B60;
  font-weight: 500;
}

.info-meta-dot {
  margin: 0 12rpx;
  color: #B5B0A4;
  font-size: 24rpx;
}

.type-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 22rpx;
  background: #EEF5E5;
  border-radius: 30rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.type-chip .chip-text {
  font-size: 24rpx;
  color: #6BA65C;
  font-weight: 700;
}

/* 标签区 */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.info-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.chip-season {
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  color: #6BA65C;
}

.chip-thickness {
  background: linear-gradient(135deg, #FFFBEB 0%, #FFE8B5 100%);
  color: #B8791F;
}

/* 分隔线 */
.divider-line {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #EFE5D3 20%, #EFE5D3 80%, transparent 100%);
  margin: 20rpx 0 28rpx;
}

/* 状态胶囊切换 */
.status-section {
  margin-bottom: 28rpx;
}

.status-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #2A2A28;
  margin-bottom: 16rpx;
}

.status-capsules {
  display: flex;
  gap: 12rpx;
}

.status-capsule {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx;
  background: #FFFFFF;
  border: 2rpx solid #EFE5D3;
  border-radius: 24rpx;
  transition: all 0.25s ease;
}

.status-capsule.active {
  background: linear-gradient(135deg, #EEF5E5 0%, #DFEAD6 100%);
  border-color: #6BA65C;
  box-shadow: 0 6rpx 16rpx rgba(107, 166, 92, 0.22);
}

.status-capsule.stored {
  background: linear-gradient(135deg, #FFFBEB 0%, #FFE8B5 100%);
  border-color: #F2B84B;
  box-shadow: 0 6rpx 16rpx rgba(242, 184, 75, 0.22);
}

.status-capsule.retired {
  background: linear-gradient(135deg, #F5F5F5 0%, #E8E8E8 100%);
  border-color: #999;
  box-shadow: 0 4rpx 12rpx rgba(153, 153, 153, 0.18);
}

.capsule-emoji {
  font-size: 32rpx;
  margin-bottom: 6rpx;
  line-height: 1;
}

.capsule-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #6F6B60;
}

.status-capsule.active .capsule-text {
  color: #6BA65C;
}

.status-capsule.stored .capsule-text {
  color: #B8791F;
}

.status-capsule.retired .capsule-text {
  color: #666;
}

/* 风格标签 */
.style-tag-section {
  margin-top: 4rpx;
}

.style-tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  margin-top: 4rpx;
}

/* ========== 穿着统计卡片 ========== */

.stats-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx 20rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFBF4 100%);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(173, 156, 108, 0.1),
              inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 8rpx;
}

.stat-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.stat-icon-worn {
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
}

.stat-icon-date {
  background: linear-gradient(145deg, #FFE4B5 0%, #FFD89A 100%);
}

.stat-icon-status {
  background: linear-gradient(145deg, #F8F0E5 0%, #F5E6D3 100%);
}

.stat-icon-status.active {
  background: linear-gradient(145deg, #EEF5E5 0%, #DFEAD6 100%);
}

.stat-icon-status.stored {
  background: linear-gradient(145deg, #FFE4B5 0%, #FFD89A 100%);
}

.stat-icon-status.retired {
  background: linear-gradient(145deg, #E8E8E8 0%, #D8D8D8 100%);
}

.stat-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.stat-number {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #2A2A28;
  margin-bottom: 4rpx;
  line-height: 1.3;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6F6B60;
  font-weight: 500;
}

.stat-divider {
  width: 2rpx;
  background: #EFE5D3;
  margin: 16rpx 0;
}

/* ========== 穿搭记录卡片 ========== */

.diary-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFFBF4 100%);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(173, 156, 108, 0.1),
              inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
}

.diary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.diary-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2A2A28;
}

.diary-count {
  font-size: 24rpx;
  color: #6F6B60;
  font-weight: 600;
}

.diary-scroll {
  white-space: nowrap;
  padding: 4rpx 0;
}

.diary-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  width: 140rpx;
}

.diary-item:last-child {
  margin-right: 0;
}

.diary-photo-box {
  width: 130rpx;
  height: 130rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #F8F0E5 0%, #F5E6D3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #EFE5D3;
  margin-bottom: 10rpx;
}

.diary-photo {
  width: 100%;
  height: 100%;
}

.diary-photo-ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.diary-date {
  font-size: 22rpx;
  color: #6F6B60;
  font-weight: 500;
}

/* ========== 底部操作区 ========== */

.action-section {
  padding: 28rpx 32rpx 48rpx;
}

.btn-edit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  padding: 0;
}

.btn-edit::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  line-height: 1;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 700;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 28rpx;
}

.action-btn::after {
  border: none;
}

.btn-icon-sm {
  font-size: 28rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.btn-text-sm {
  font-size: 28rpx;
  font-weight: 600;
}

