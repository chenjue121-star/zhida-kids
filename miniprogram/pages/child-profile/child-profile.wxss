.child-profile-page {
  padding: 32rpx;
  padding-bottom: 180rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-upload {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #EEF5E5;
  margin-bottom: 16rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFF9EF;
}

.avatar-icon {
  font-size: 56rpx;
}

.avatar-text {
  font-size: 22rpx;
  color: #B5B0A4;
  margin-top: 8rpx;
}

.ai-avatar-card {
  margin-bottom: 32rpx;
}

.ai-avatar-header {
  margin-bottom: 16rpx;
}

.btn-mini {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  background: #6BA65C;
  color: #fff;
  border-radius: 20rpx;
  line-height: 1.5;
}

.btn-mini::after {
  border: none;
}

.ai-avatar-preview {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-avatar-img {
  height: 100%;
}

.ai-avatar-placeholder {
  padding: 40rpx;
  text-align: center;
  background: #FFF9EF;
  border-radius: 24rpx;
}

.ai-avatar-message {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
  background: #EEF5E5;
  color: #6BA65C;
  font-size: 24rpx;
  line-height: 1.5;
}

.ai-avatar-prompt {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #FDF1D9;
  color: #6F6B60;
  font-size: 23rpx;
  line-height: 1.6;
}

.form-container {
  margin-top: 16rpx;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid #EFE5D3;
  border-radius: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.picker-display {
  display: flex;
  align-items: center;
  line-height: 84rpx;
}

.placeholder {
  color: #B5B0A4;
}

.form-row {
  display: flex;
}

.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #EFE5D3;
  border-radius: 32rpx;
}

.gender-item.active {
  border-color: #6BA65C;
  background: #EEF5E5;
}

.gender-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 14rpx 28rpx;
  border: 2rpx solid #EFE5D3;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #6F6B60;
  background: #fff;
}

.tag-item.active {
  border-color: #6BA65C;
  background: #EEF5E5;
  color: #6BA65C;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
}

